            syncInterval: 300000 // Sincronización cada 5 minutos
        });
        this.pesosSinapticosRegionais = this._inicializarPesosPorRegion();
    }

    _inicializarPesosPorRegion() {
        return Object.keys(CONFIG.NORMATIVAS_REGIONALES).reduce((acc, region) => {
            acc[region] = Array.from({ length: 6 }, () => 
                Array.from({ length: 64 }, () => Math.random() * 0.2 - 0.1)
            );
            return acc;
        }, {});
