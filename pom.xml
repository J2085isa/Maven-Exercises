    def project_next_quarter(self, historical_data):
        """Genera proyecciones basadas en datos históricos"""
        growth_rate = 0.10  # Tasa de crecimiento esperada (ajustable)
        projected_ingresos = historical_data["ingresos"] * (1 + growth_rate)
        projected_gastos = historical_data["gastos"] * (1 + growth_rate)
        projected_iva = (projected_ingresos * 0.16) - (projected_gastos * 0.16)
        projected_isr = (projected_ingresos - projected_gastos) * 0.30

        # Incluir créditos pendientes
        projected_credits = 25000.00  # Créditos de inversiones programados
        projected_final_payment_iva = max(projected_iva - projected_credits, 0.00)
