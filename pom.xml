    },

    // --- INICIALIZACIÓN COMPLETA ---
    init: function(customConfig = {}) {
        // Fusionar configuración personalizada con la por defecto
        Object.assign(this.config, customConfig);
        
        // Validar configuración
        if (this.config.checkInterval < 1000) {
            this._log("⚠️ Intervalo de escaneo demasiado corto — ajustado a 1000ms", 'warning');
            this.config.checkInterval = 1000;
        }

        // Registrar eventos de red
        window.addEventListener('offline', () => this.onDisconnect());
        window.addEventListener('online', () => this.onReconnect());
        
        // Iniciar escaneo periódico adicional (más allá de eventos nativos)
        this.state.intervaloEscaneo = setInterval(() => this._escanearEstadoRed(), this.config.checkInterval);

        // Mensaje de bienvenida estilizado
        this._log(
            "📡 Vigilancia de red activada: Flujo de liquidez monitoreado | Intervalo: " + this.config.checkInterval + "ms",
            'success',
            true // Mensaje destacado
        );

        // Verificar estado inicial
        this._escanearEstadoRed();
    },

    // --- DETECCIÓN DE DESCONEXIÓN ---
    onDisconnect: function() {
        this.state.conexionActiva = false;
        this.state.ultimoEvento = 'desconectado';
        this.state.intentosRestauracion = 0; // Reiniciar contador de intentos

        // Alerta visual y táctil
        this._log(
            "⚠️ RED PERDIDA: El Escudo Dinámico está en modo reserva | Última comprobación: " + new Date().toLocaleTimeString(),
            'error',
