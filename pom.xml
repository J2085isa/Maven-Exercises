        this.redNeuronal.train([entrada], { iterations: 10, log: false });

        // Actualización de pesos sinápticos (plasticidad)
        const salidaPredicha = this.redNeuronal.run(datosEntrenamiento);
        const deltaPesos = datosEntrenamiento.map(val => 
            this.pesosSinapticos[0].map(peso => peso + 0.01 * val * salidaPredicha[etiqueta])
        );
        this.pesosSinapticos = deltaPesos;
    }

    /**
     * Clasifica riesgo de fraude basado en patrones aprendidos
     * @param {Array<number>} datos - Vector de características
     * @returns {number} Probabilidad de fraude (0-1)
     */
    clasificarRiesgo(datos) {
        const prediccion = this.redNeuronal.run(datos);
        return prediccion[1] || 0;
    }
}

/**
 * Módulo de Verificación Cuántica: Usa superposición e interferencia
 * para medir similitud entre promesas del anuncio y datos reales
 */
class ModuloVerificacionCuantica {
    constructor() {
        this.simulador = new Simulator();
    }

    /**
     * Crea circuito cuántico para codificar y comparar datos
     * @param {Array<number>} vectorPromesa - Datos de la promesa normalizados
     * @param {Array<number>} vectorRealidad - Datos reales normalizados
     * @returns {Circuit} Circuito cuántico configurado
     */
    _crearCircuitoCuantico(vectorPromesa, vectorRealidad) {
        const nQubits = Math.ceil(Math.log2(vectorPromesa.length));
        const circuito = new Circuit(nQubits, nQubits);

        // Puerta Hadamard para superposición inicial
        circuito.applyGate(new H(), Array.from({ length: nQubits }, (_, i) => new Qubit(i)));

        // Codificación de datos en ángulos de rotación
        vectorPromesa.forEach((valor, idx) => {
            circuito.applyGate(new RX(valor * Math.PI), new Qubit(idx));
            circuito.applyGate(new RY(vectorRealidad[idx] * Math.PI), new Qubit(idx));
        });

        // Puerta CZ para interferencia (resaltar diferencias)
        circuito.applyGate(new CZ(), [new Qubit(0), new Qubit(1)]);

        // Puerta Hadamard final y medición
        circuito.applyGate(new H(), Array.from({ length: nQubits }, (_, i) => new Qubit(i)));
        circuito.applyGate(new Measure(), Array.from({ length: nQubits }, (_, i) => new Qubit(i)));

        return circuito;
    }

    /**
     * Mide probabilidad de cumplimiento usando el circuito cuántico
     * @param {Object} datosPromesa - Promesas del anuncio
     * @param {Object} datosRealidad - Datos de pagos reales
     * @returns {number} Probabilidad de cumplimiento (0-1)
     */
    medirCumplimiento(datosPromesa, datosRealidad) {
        // Convertir datos a vectores normalizados
        const valoresPromesa = Object.values(datosPromesa);
        const valoresRealidad = Object.values(datosRealidad);
        const vectorP = normalize(valoresPromesa);
        const vectorR = normalize(valoresRealidad);

        // Ajustar longitud a potencia de 2 para compatibilidad cuántica
        const lenMax = Math.pow(2, Math.ceil(Math.log2(Math.max(vectorP.length, vectorR.length))));
        const vectorPAjustado = [...vectorP, ...Array(lenMax - vectorP.length).fill(0)];
        const vectorRAjustado = [...vectorR, ...Array(lenMax - vectorR.length).fill(0)];

        // Ejecutar circuito y contar resultados
        const circuito = this._crearCircuitoCuantico(vectorPAjustado, vectorRAjustado);
        const resultado = this.simulador.run(circuito, { shots: 1024 });
        const conteos = resultado.getCounts();

        // Calcular coincidencias (resultados con número par de bits 1)
        const conteosCoincidentes = Object.entries(conteos).reduce((total, [clave, valor]) => {
            const numUnos = clave.split('').filter(bit => bit === '1').length;
            return total + (numUnos % 2 === 0 ? valor : 0);
        }, 0);

        return conteosCoincidentes / 1024;
    }
}

