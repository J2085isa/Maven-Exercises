class TaxCreditManager:
    def __init__(self, jose_rfc, sat_api_key):
        self.rfc = jose_rfc
        self.sat_api_key = sat_api_key
        self.sat_cfdi_url = "https://api.sat.gob.mx/cfdi/v1/consulta"

    def get_valid_credits(self, period):
        """Obtiene y valida créditos fiscales del periodo indicado"""
        # Consulta todos los CFDI recibidos por José Isaías
        cfdi_received = requests.post(
            self.sat_cfdi_url,
            headers={"Authorization": f"Bearer {self.sat_api_key}"},
            json={"rfc_receptor": self.rfc, "periodo": period}
        ).json()["cfdi"]

        valid_credits = {
            "iva": 0.00,
            "isr": 0.00,
            "otros": 0.00
        }

        for cfdi in cfdi_received:
            # Verifica que el CFDI sea válido y no esté cancelado
            if cfdi["estado"] == "vigente":
                # Añade créditos correspondientes
                if cfdi["impuesto"] == "IVA" and cfdi["tipo"] == "credito":
                    valid_credits["iva"] += cfdi["monto_credito"]
                elif cfdi["impuesto"] == "ISR" and cfdi["tipo"] == "retencion":
                    valid_credits["isr"] += cfdi["monto_credito"]
                elif cfdi["impuesto"] in ["IEPS", "OTROS"] and cfdi["tipo"] == "credito":
                    valid_credits["otros"] += cfdi["monto_credito"]

        return valid_credits

    def apply_credits(self, tax_type, amount_to_pay, pending_credits):
        """Aplica créditos fiscales al monto a pagar"""
        credit_available = pending_credits.get(tax_type, 0.00)
        
        if credit_available >= amount_to_pay:
            final_payment = 0.00
            new_pending = credit_available - amount_to_pay
            print(f"Crédito aplicado completo: ${amount_to_pay:.2f}. Saldo pendiente: ${new_pending:.2f}")
        else:
            final_payment = amount_to_pay - credit_available
            new_pending = 0.00
            print(f"Crédito aplicado: ${credit_available:.2f}. Monto a pagar final: ${final_payment:.2f}")

        return final_payment, new_pending

