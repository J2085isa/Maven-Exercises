import requests
from datetime import datetime

class InvestmentTaxCreditTracker:
    def __init__(self, jose_rfc, sat_api_key, sener_api_key):
        self.rfc = jose_rfc
        self.sat_api_key = sat_api_key
        self.sener_api_key = sener_api_key
        self.investments = []

    def register_investment(self, inv_data):
        """Registra una nueva inversión y valida su elegibilidad"""
        # Datos de la inversión: tipo, monto, fecha, proveedor, documento
        inv_data["id_inversion"] = str(datetime.now().timestamp()).replace(".", "")
        inv_data["califica"] = self._check_eligibility(inv_data["tipo"], inv_data["descripcion"])
        
        if inv_data["califica"]:
            inv_data["credito_calculado"] = self._calculate_credit(inv_data["tipo"], inv_data["monto"])
            self.investments.append(inv_data)
            print(f"Inversión registrada: Crédito fiscal de ${inv_data['credito_calculado']:.2f}")
        else:
            print("La inversión no califica para créditos fiscales")
        return inv_data

    def _check_eligibility(self, inv_type, description):
        """Verifica si la inversión califica ante SAT/SENER"""
        if inv_type == "energia_limpia":
            response = requests.post(
                "https://api.sener.gob.mx/equipos_calificados/v1",
                headers={"Authorization": f"Bearer {self.sener_api_key}"},
                json={"descripcion_equipo": description}
            )
            return response.json()["calificado"]
        elif inv_type == "tecnologia":
            response = requests.post(
                "https://api.sat.gob.mx/tecnologia_calificada/v1",
                headers={"Authorization": f"Bearer {self.sat_api_key}"},
                json={"descripcion_producto": description}
            )
            return response.json()["calificado"]
        elif inv_type == "zonas_prioritarias":
            # Verificar zona según código postal
            return inv_data["codigo_postal"] in ["50000", "60000", ...]  # Ejemplo de zonas
        return False

    def _calculate_credit(self, inv_type, amount):
        """Calcula el crédito fiscal según el tipo de inversión"""
        rates = {
            "energia_limpia": 0.30,
            "tecnologia": 0.25,
            "zonas_prioritarias": 0.20
        }
        return amount * rates.get(inv_type, 0.0)

