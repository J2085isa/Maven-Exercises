class GestorRecursos: @staticmethod def asignar(estructura, parametros): """Distribuye recursos dinámicamente según estructura y entorno""" recursos_disponibles = GR.medir_recursos_totales()

    if parametros["tipo_entorno"] == "V":
        asignacion = {
