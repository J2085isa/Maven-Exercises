        let estilo = "";
        switch(tipo) {
            case 'success': estilo = "color: #5cb85c;"; break;
            case 'error': estilo = "color: #d9534f; font-weight: bold;"; break;
            case 'warning': estilo = "color: #f0ad4e; font-weight: 500;"; break;
            case 'info': estilo = "color: #2c7fb8;"; break;
            default: estilo = "color: #333;";
        }

        if (destacado) {
            estilo += " font-size: 14px; padding: 2px 0;";
            mensaje = "━ " + mensaje + " ━";
        }

        console.log("%c" + mensaje, estilo);
    },

    // --- DETENCIÓN SEGURA DEL PROTOCOLO ---
    stop: function() {
        clearInterval(this.state.intervaloEscaneo);
        window.removeEventListener('offline', this.onDisconnect);
        window.removeEventListener('online', this.onReconnect);
        this._log("🛑 Vigilancia de red desactivada manualmente", 'warning', true);
