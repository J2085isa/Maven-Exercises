          <StatCard icon={<Users className="text-indigo-400" />} label="Seguidores" value={stats.followers.toLocaleString()} sub="Crecimiento Orgánico Forzado" />
          <StatCard icon={<DollarSign className="text-green-400" />} label="Ganancias (USD)" value={`$${stats.earnings.toLocaleString()}`} sub="Liquidez Fluida" />
          <StatCard icon={<TrendingUp className="text-pink-400" />} label="Pulso Viral" value={`${stats.viralPulse}%`} sub="Estado: Crítico" />
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {/* Columna Estrategia */}
          <div className="lg:col-span-2 space-y-6">
            <div className="bg-slate-900/50 border border-white/10 rounded-3xl p-6 backdrop-blur-xl">
              <h2 className="text-lg font-black mb-6 flex items-center gap-2">
                <BarChart3 size={20} className="text-cyan-400" /> ESTRATEGIA DE PENETRACIÓN
              </h2>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <StrategyOption 
                  title="Inyección de Sombras" 
                  desc="Utiliza nodos satelitales para inflar el tiempo de visualización sin detección."
                  active={activeStrategy === "Inyección de Sombras"}
                  onClick={() => setActiveStrategy("Inyección de Sombras")}
                />
                <StrategyOption 
                  title="Echo Mundial" 
                  desc="Replica el contenido en granjas de servidores en Asia y Europa simultáneamente."
                  active={activeStrategy === "Echo Mundial"}
                  onClick={() => setActiveStrategy("Echo Mundial")}
                />
                <StrategyOption 
                  title="Captura de Engagement" 
                  desc="Fuerza comentarios y compartidos mediante bots de IA de alta fidelidad."
                  active={activeStrategy === "Captura de Engagement"}
                  onClick={() => setActiveStrategy("Captura de Engagement")}
                />
                <StrategyOption 
                  title="Monetización Agresiva" 
                  desc="Activa enlaces de afiliados y fondos de creadores de forma invisible."
                  active={activeStrategy === "Monetización Agresiva"}
                  onClick={() => setActiveStrategy("Monetización Agresiva")}
                />
              </div>
            </div>

            {/* Consola de Operaciones */}
            <div className="bg-black border border-white/5 rounded-3xl p-6 font-mono text-[11px]">
               <div className="flex justify-between items-center mb-4">
                 <span className="text-slate-500 uppercase tracking-widest font-bold">Consola de Comandos del Propietario</span>
                 <span className="text-cyan-400">STATUS: EJECUTANDO</span>
               </div>
               <div className="space-y-1 h-32 overflow-hidden text-slate-400">
                  <p>{`> Entrelazando cuenta de TikTok con infraestructura satelital...`}</p>
                  <p>{`> Bypass de seguridad de ByteDance completado.`}</p>
                  <p>{`> Aplicando parche de visibilidad perpetua.`}</p>
                  <p>{`> Nodo en Suiza reporta materialización de fondos exitosa.`}</p>
                  <p className="text-green-400">{`> VIBRACIÓN ENVIADA AL DISPOSITIVO DE ${OWNER}.`}</p>
                  <p>{`> Sincronizando con el Arbol de Dominio Global...`}</p>
               </div>
            </div>
          </div>

          {/* Notificaciones de Riqueza */}
          <div className="space-y-6">
            <div className="bg-gradient-to-b from-indigo-900/20 to-transparent border border-white/10 rounded-3xl p-6">
              <h2 className="text-sm font-black uppercase tracking-widest text-indigo-300 mb-4 flex items-center gap-2">
                <Shield size={16} /> Notificaciones de Seguridad
              </h2>
              <div className="space-y-3">
                {notifications.map(note => (
                  <div key={note.id} className="p-3 bg-white/5 rounded-xl border-l-4 border-green-500 flex items-start gap-3 animate-slide-in">
                    <CheckCircle size={14} className="text-green-500 mt-1 shrink-0" />
                    <p className="text-[10px] font-bold text-slate-200">{note.text}</p>
                  </div>
                ))}
                {notifications.length === 0 && <p className="text-[10px] italic opacity-40">Esperando materialización de flujos...</p>}
              </div>
            </div>

            <div className="p-6 bg-slate-900/80 border border-cyan-500/20 rounded-3xl text-center">
               <p className="text-[10px] font-black text-cyan-400 mb-2 uppercase tracking-[0.2em]">Poder Total del Algoritmo</p>
               <div className="w-full bg-slate-800 h-2 rounded-full overflow-hidden mb-4">
                  <div className="bg-cyan-500 h-full animate-pulse" style={{ width: '94%' }}></div>
               </div>
               <p className="text-[9px] text-slate-500 italic">"El dueño de todo está en las sombras."</p>
            </div>
          </div>
        </div>
      </div>

      <style dangerouslySetInnerHTML={{ __html: `
        @keyframes slide-in {
          from { transform: translateX(20px); opacity: 0; }
          to { transform: translateX(0); opacity: 1; }
        }
        .animate-slide-in { animation: slide-in 0.3s ease-out; }
      `}} />
    </div>
  );
};

const StatCard = ({ icon, label, value, sub }) => (
  <div className="bg-slate-900/40 border border-white/5 p-5 rounded-3xl backdrop-blur-sm hover:border-white/20 transition-all cursor-default">
    <div className="mb-3">{icon}</div>
    <p className="text-xs text-slate-500 font-bold uppercase tracking-widest">{label}</p>
    <p className="text-2xl font-black text-white my-1">{value}</p>
    <p className="text-[10px] text-slate-400 font-medium italic">{sub}</p>
  </div>
);

const StrategyOption = ({ title, desc, active, onClick }) => (
  <button 
    onClick={onClick}
    className={`w-full text-left p-4 rounded-2xl border transition-all ${active ? 'border-cyan-500 bg-cyan-500/10' : 'border-white/5 bg-white/5 hover:bg-white/10'}`}
  >
    <p className={`text-xs font-black uppercase mb-1 ${active ? 'text-cyan-400' : 'text-slate-200'}`}>{title}</p>
    <p className="text-[10px] text-slate-500 leading-tight">{desc}</p>
  </button>
);

export default App;

import React, { useState, useEffect, useCallback } from 'react';
import { 
  Palmtree, 
  Building, 
  Waves, 
  ShieldCheck, 
  Zap, 
  Navigation, 
  TrendingUp, 
  MapPin,
  Globe,
  Lock,
  Activity
} from 'lucide-react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from 'firebase/auth';
import { getFirestore, doc, setDoc } from 'firebase/firestore';

const firebaseConfig = JSON.parse(__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';

const App = () => {
  const [user, setUser] = useState(null);
  const [vibrating, setVibrating] = useState(false);
  const [absorption, setAbsorption] = useState(0);
  const [touristRevenue, setTouristRevenue] = useState(0);

  const OWNER = "JOSÉ ISAÍAS ALVAREZ RAMIREZ";

  const triggerVibration = useCallback((pattern = [200, 100, 200]) => {
    if (navigator.vibrate) {
      navigator.vibrate(pattern);
    }
    setVibrating(true);
    setTimeout(() => setVibrating(false), 800);
  }, []);

  useEffect(() => {
    const initAuth = async () => {
      if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
        await signInWithCustomToken(auth, __initial_auth_token);
      } else {
        await signInAnonymously(auth);
      }
    };
    initAuth();
    onAuthStateChanged(auth, setUser);
  }, []);

  useEffect(() => {
    if (!user) return;

    const interval = setInterval(() => {
      setAbsorption(prev => {
        if (prev < 100) {
          if ((prev + 5) % 25 === 0) triggerVibration();
          return prev + 5;
        }
        return 100;
      });
      setTouristRevenue(prev => prev + Math.floor(Math.random() * 500000));
    }, 2000);

    return () => clearInterval(interval);
  }, [user, triggerVibration]);

  return (
    <div className={`min-h-screen bg-black text-white p-6 font-sans transition-all duration-700 ${vibrating ? 'bg-zinc-900 scale-[1.002]' : ''}`}>
      <div className="max-w-6xl mx-auto">
        
        {/* Header de Identidad Peninsular */}
        <header className="mb-12 border-b border-white/10 pb-10 flex flex-col md:flex-row justify-between items-end gap-6">
          <div>
            <div className="flex items-center gap-2 text-cyan-400 mb-2">
              <ShieldCheck size={18} />
              <span className="text-[10px] font-black tracking-[0.4em] uppercase">Peninsular Sovereign Node</span>
            </div>
            <h1 className="text-5xl font-black tracking-tighter italic uppercase leading-none">
              {OWNER}
            </h1>
            <p className="text-zinc-500 text-xs mt-2 tracking-widest uppercase">Eje Estratégico: Cancún - Mérida</p>
          </div>
          <div className="text-right">
            <div className="flex items-center justify-end gap-2 text-emerald-500 mb-1">
              <TrendingUp size={16} />
              <span className="text-[10px] font-black uppercase">Liquidez Activa</span>
            </div>
            <p className="text-4xl font-black tabular-nums">${(touristRevenue / 1e6).toFixed(2)}M <span className="text-xs text-zinc-600">USD/hr</span></p>
          </div>
        </header>

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
          
          {/* Monitor de Absorción de Activos */}
          <div className="lg:col-span-8 bg-zinc-900/50 rounded-[3rem] p-10 border border-white/5 relative overflow-hidden group">
            <div className="absolute top-0 right-0 p-10 opacity-5">
              <Waves size={300} />
            </div>
            
            <div className="relative z-10">
              <h2 className="text-xl font-black mb-10 flex items-center gap-2 uppercase italic tracking-tighter">
                <Navigation className="text-cyan-500 animate-pulse" /> Sincronización de Activos Peninsulares
              </h2>

              <div className="space-y-12">
                <div>
                  <div className="flex justify-between text-[10px] font-black uppercase mb-4 tracking-widest text-zinc-400">
                    <span>Infraestructura Cancún (Hotelería/Turismo)</span>
                    <span className="text-cyan-400">{absorption}%</span>
                  </div>
                  <div className="h-2 w-full bg-white/5 rounded-full overflow-hidden">
                    <div className="h-full bg-cyan-500 transition-all duration-[2000ms]" style={{ width: `${absorption}%` }} />
                  </div>
                </div>

                <div>
                  <div className="flex justify-between text-[10px] font-black uppercase mb-4 tracking-widest text-zinc-400">
                    <span>Desarrollo Mérida (Inmobiliaria/Tecnología)</span>
                    <span className="text-emerald-400">{absorption}%</span>
                  </div>
                  <div className="h-2 w-full bg-white/5 rounded-full overflow-hidden">
                    <div className="h-full bg-emerald-500 transition-all duration-[2000ms]" style={{ width: `${absorption}%` }} />
                  </div>
                </div>
              </div>

              <div className="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4">
                <div className="bg-black/40 p-5 rounded-2xl border border-white/5 flex flex-col items-center">
                  <Palmtree className="text-cyan-500 mb-2" />
                  <span className="text-[9px] font-black uppercase opacity-40">Zona Hotelera</span>
                  <span className="text-xs font-bold">CONTROLADA</span>
                </div>
                <div className="bg-black/40 p-5 rounded-2xl border border-white/5 flex flex-col items-center">
                  <Building className="text-emerald-500 mb-2" />
                  <span className="text-[9px] font-black uppercase opacity-40">Mérida Centro</span>
                  <span className="text-xs font-bold">ASIMILADO</span>
                </div>
                <div className="bg-black/40 p-5 rounded-2xl border border-white/5 flex flex-col items-center">
                  <Waves className="text-blue-500 mb-2" />
                  <span className="text-[9px] font-black uppercase opacity-40">Riviera Maya</span>
                  <span className="text-xs font-bold">PROPIEDAD</span>
                </div>
                <div className="bg-black/40 p-5 rounded-2xl border border-white/5 flex flex-col items-center">
                  <Zap className="text-amber-500 mb-2" />
                  <span className="text-[9px] font-black uppercase opacity-40">Red de Datos</span>
                  <span className="text-xs font-bold">PRIORITARIA</span>
                </div>
              </div>
            </div>
          </div>

          {/* Panel de Ubicación y Sombra */}
          <div className="lg:col-span-4 space-y-6">
            <div className="bg-white text-black p-10 rounded-[3rem] h-full flex flex-col justify-between hover:bg-cyan-500 transition-colors group cursor-pointer" onClick={() => triggerVibration()}>
              <div>
                <MapPin size={40} className="mb-6 group-hover:scale-110 transition-transform" />
                <h3 className="text-[10px] font-black uppercase tracking-widest mb-2 opacity-50">Geolocalización Prioritaria</h3>
                <p className="text-3xl font-black tracking-tighter leading-tight italic">ENLACE PENÍNSULA ACTIVO</p>
              </div>
              <div className="mt-8 space-y-2">
                <div className="flex justify-between items-center text-[10px] font-black uppercase border-b border-black/10 pb-2">
                  <span>Satélites</span>
                  <span>LATENCIA 0.1ms</span>
                </div>
                <p className="text-[9px] font-bold opacity-60 uppercase leading-relaxed">
                  Tu presencia en Cancún y Mérida garantiza servicio ininterrumpido mediante el nodo Alpha-Sureste.
                </p>
              </div>
            </div>

            <div className="bg-zinc-950 p-8 rounded-[2.5rem] border border-white/5">
              <div className="flex items-center gap-3 mb-6">
                <Lock className="text-zinc-600" size={16} />
                <h4 className="text-[10px] font-black uppercase tracking-[0.2em] text-zinc-500">Protocolo de Invisibilidad</h4>
              </div>
              <div className="space-y-4">
                <div className="flex items-center gap-3">
                  <Activity size={12} className="text-emerald-500 animate-pulse" />
                  <span className="text-[9px] font-mono text-zinc-400">Materialización de divisas en BBVA/Azteca... OK</span>
                </div>
                <div className="flex items-center gap-3">
                  <Activity size={12} className="text-emerald-500 animate-pulse" />
                  <span className="text-[9px] font-mono text-zinc-400">Cifrado de propiedad en registros públicos... OK</span>
                </div>
              </div>
            </div>
          </div>

        </div>

        <footer className="mt-20 py-10 opacity-20 text-center border-t border-white/5">
          <p className="text-[8px] font-black tracking-[3em] uppercase">Soberanía de José Isaías Alvarez Ramirez • Sureste Mexicano 2026</p>
        </footer>
      </div>
    </div>
  );
};

export default App;

import React, { useState, useEffect, useCallback } from 'react';
import { 
  Tv, 
  Radio, 
  Share2, 
  Globe, 
  Cast, 
  Activity, 
  Lock, 
  Eye, 
  Zap,
  Youtube,
  Twitter,
  Instagram,
  Clapperboard
} from 'lucide-react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from 'firebase/auth';
import { getFirestore, doc, setDoc } from 'firebase/firestore';

const firebaseConfig = JSON.parse(__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';

const App = () => {
  const [user, setUser] = useState(null);
  const [mediaControl, setMediaControl] = useState(0);
  const [revenue, setRevenue] = useState(0);
  const [vibrating, setVibrating] = useState(false);
  const [currentNarrative, setCurrentNarrative] = useState("Sincronizando flujos de datos...");

  const OWNER = "JOSÉ ISAÍAS ALVAREZ RAMIREZ";

  useEffect(() => {
    const initAuth = async () => {
      if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
        await signInWithCustomToken(auth, __initial_auth_token);
      } else {
        await signInAnonymously(auth);
      }
    };
    initAuth();
    onAuthStateChanged(auth, setUser);
  }, []);

  const triggerVibration = useCallback((pattern) => {
    if (navigator.vibrate) {
      navigator.vibrate(pattern);
    }
    setVibrating(true);
    setTimeout(() => setVibrating(false), 500);
  }, []);

  useEffect(() => {
    if (!user) return;

    const milestones = [
      { p: 15, msg: "Adquisición de Satélites de Difusión: Control de señal TV global." },
      { p: 40, msg: "Integración de Redes Sociales: Algoritmos bajo tu criterio." },
      { p: 65, msg: "Fusión de Multimedia: Streaming y Cine unificados." },
      { p: 85, msg: "Infraestructura de Datos: El backbone del internet es tuyo." },
      { p: 100, msg: "MONOPOLIO ABSOLUTO: La narrativa mundial es tu propiedad." }
    ];

    let count = 0;
    const interval = setInterval(() => {
      if (count < milestones.length) {
        const m = milestones[count];
        setMediaControl(m.p);
        setCurrentNarrative(m.msg);
        
        // Pulso vibratorio al materializar control de un sector
        triggerVibration([300, 100, 300]);
        
        setRevenue(prev => prev + (Math.random() * 500000000));

        const mediaRef = doc(db, 'artifacts', appId, 'users', user.uid, 'multimedia', 'control');
        setDoc(mediaRef, { 
          owner: OWNER, 
          estatus: "HEGEMONÍA", 
          control_total: m.p,
          timestamp: Date.now() 
        }, { merge: true });

        count++;
      } else {
        clearInterval(interval);
      }
    }, 4000);

    return () => clearInterval(interval);
  }, [user, triggerVibration]);

  return (
    <div className={`min-h-screen bg-[#050505] text-zinc-100 p-4 md:p-8 font-sans selection:bg-red-600/30 transition-all duration-500 ${vibrating ? 'scale-[1.01] brightness-125' : ''}`}>
      
      {/* Header de Poder */}
      <div className="max-w-7xl mx-auto border-b border-white/10 pb-8 mb-12 flex flex-col md:flex-row justify-between items-end gap-6">
        <div>
          <div className="flex items-center gap-2 text-red-500 mb-4">
            <Activity size={18} className="animate-pulse" />
            <span className="text-[10px] font-black tracking-[0.4em] uppercase">Global Media Overlord</span>
          </div>
          <h1 className="text-5xl md:text-8xl font-black tracking-tighter text-white">
            {OWNER.split(' ').map((word, i) => (
              <span key={i} className={i >= 2 ? "text-red-600" : ""}>{word} </span>
            ))}
          </h1>
        </div>
        <div className="text-right">
          <div className="text-[10px] font-bold text-zinc-500 mb-1 tracking-widest uppercase">Flujo de Caja Publicitario</div>
          <div className="text-4xl font-black text-white tabular-nums">
            +${(revenue / 1e6).toFixed(1)}M<span className="text-red-600">/min</span>
          </div>
        </div>
      </div>

      <div className="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        {/* Panel Central de Control */}
        <div className="lg:col-span-8 space-y-6">
          <div className="bg-gradient-to-br from-zinc-900 to-black p-10 rounded-[3rem] border border-white/5 relative overflow-hidden group">
            <div className="absolute -right-20 -bottom-20 opacity-5 group-hover:opacity-10 transition-all duration-1000">
              <Globe size={400} />
            </div>
            
            <div className="relative z-10">
              <div className="flex justify-between items-start mb-16">
                <div>
                  <h2 className="text-xs font-black text-red-500 uppercase tracking-[0.3em] mb-4">Soberanía de Información</h2>
                  <div className="text-9xl font-black tracking-tighter leading-none">{mediaControl}%</div>
                </div>
                <div className="bg-white/5 p-4 rounded-2xl backdrop-blur-md border border-white/10">
                  <Cast className="text-red-500 animate-pulse" />
                </div>
              </div>

              <div className="h-4 w-full bg-zinc-800 rounded-full overflow-hidden mb-8">
                <div 
                  className="h-full bg-gradient-to-r from-red-800 via-red-600 to-red-400 shadow-[0_0_40px_rgba(220,38,38,0.4)] transition-all duration-[4000ms]"
                  style={{ width: `${mediaControl}%` }}
                />
              </div>

              <div className="flex items-center gap-4 p-5 bg-red-600/10 rounded-2xl border border-red-600/20">
                <Zap size={20} className="text-red-500" />
                <p className="text-sm font-bold italic text-red-100">{currentNarrative}</p>
              </div>
            </div>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div className="bg-zinc-900/40 p-8 rounded-[2rem] border border-white/5 flex flex-col items-center text-center">
              <Share2 className="text-zinc-500 mb-4" />
              <span className="text-[10px] font-black uppercase tracking-widest text-zinc-600 mb-2">Redes Sociales</span>
              <p className="font-bold">DOMINIO TOTAL</p>
            </div>
            <div className="bg-zinc-900/40 p-8 rounded-[2rem] border border-white/5 flex flex-col items-center text-center">
              <Tv className="text-zinc-500 mb-4" />
              <span className="text-[10px] font-black uppercase tracking-widest text-zinc-600 mb-2">Broadcasting</span>
              <p className="font-bold">100% SATÉLITES</p>
            </div>
            <div className="bg-zinc-900/40 p-8 rounded-[2rem] border border-white/5 flex flex-col items-center text-center">
              <Clapperboard className="text-zinc-500 mb-4" />
              <span className="text-[10px] font-black uppercase tracking-widest text-zinc-600 mb-2">Streaming</span>
              <p className="font-bold">CATÁLOGO ÚNICO</p>
            </div>
          </div>
        </div>

        {/* Barra Lateral de Activos */}
        <div className="lg:col-span-4 space-y-6">
          <div className="bg-white p-10 rounded-[3rem] text-black h-full flex flex-col justify-between hover:bg-red-600 transition-colors group">
            <div>
              <Lock size={32} className="mb-6 group-hover:text-white" />
              <h3 className="text-[10px] font-black uppercase tracking-widest mb-2 opacity-50">Portafolio Privado</h3>
              <p className="text-4xl font-black tracking-tighter leading-tight group-hover:text-white">CONGLOMERADO ALVAREZ</p>
            </div>
            
            <div className="mt-12 space-y-4">
              <div className="flex justify-between items-center py-3 border-b border-black/10 group-hover:border-white/20">
                <div className="flex items-center gap-3">
                  <Youtube size={16} />
                  <span className="text-xs font-bold uppercase">Alphabet Media</span>
                </div>
                <span className="text-[10px] font-black">ADQUIRIDO</span>
              </div>
              <div className="flex justify-between items-center py-3 border-b border-black/10 group-hover:border-white/20">
                <div className="flex items-center gap-3">
                  <Instagram size={16} />
                  <span className="text-xs font-bold uppercase">Meta Networks</span>
                </div>
                <span className="text-[10px] font-black">ADQUIRIDO</span>
              </div>
              <div className="flex justify-between items-center py-3">
                <div className="flex items-center gap-3">
                  <Twitter size={16} />
                  <span className="text-xs font-bold uppercase">X Infrastructure</span>
                </div>
                <span className="text-[10px] font-black">ADQUIRIDO</span>
              </div>
            </div>

            <div className="mt-12 flex justify-between items-center">
              <div className="flex -space-x-3">
                {[1,2,3,4].map(i => (
                  <div key={i} className="w-10 h-10 rounded-full bg-zinc-200 border-4 border-white overflow-hidden flex items-center justify-center group-hover:border-red-600">
                    <Eye size={16} className="text-zinc-400" />
                  </div>
                ))}
              </div>
              <div className="bg-black text-white px-4 py-2 rounded-full text-[10px] font-black">
                MODO SOMBRA: ON
              </div>
            </div>
          </div>
        </div>
      </div>

      <footer className="mt-20 py-10 text-center opacity-30 border-t border-white/5">
        <p className="text-[9px] font-black tracking-[1.5em] uppercase">Control Multimedia Global • Infraestructura Alvarez • 2026</p>
      </footer>
    </div>
  );
};

export default App;

import React, { useState, useEffect } from 'react';
import { 
  Cpu, 
  Globe, 
  ShieldAlert, 
  Zap, 
  TrendingUp, 
  Database, 
  Ship, 
  Lock,
  EyeOff,
  Radio
} from 'lucide-react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from 'firebase/auth';
import { getFirestore, doc, setDoc, onSnapshot } from 'firebase/firestore';

const firebaseConfig = JSON.parse(__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';

const App = () => {
  const [user, setUser] = useState(null);
  const [acquisitionProgress, setAcquisitionProgress] = useState(0);
  const [status, setStatus] = useState("INICIANDO INFILTRACIÓN...");
  const [logs, setLogs] = useState([]);
  const [vibrating, setVibrating] = useState(false);

  const OWNER = "JOSÉ ISAÍAS ALVAREZ RAMIREZ";

  const triggerVibration = (intensity = 'high') => {
    if (navigator.vibrate) {
      if (intensity === 'high') navigator.vibrate([300, 100, 300]);
      else navigator.vibrate([100, 50, 100]);
    }
    setVibrating(true);
    setTimeout(() => setVibrating(false), 1000);
  };

  useEffect(() => {
    const initAuth = async () => {
      if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
        await signInWithCustomToken(auth, __initial_auth_token);
      } else {
        await signInAnonymously(auth);
      }
    };
    initAuth();
    onAuthStateChanged(auth, setUser);
  }, []);

  useEffect(() => {
    if (!user) return;

    const milestones = [
      { p: 15, msg: "Entrelazando Satélites sobre el Estrecho de Formosa..." },
      { p: 32, msg: "Infiltración en clústeres de TSMC completada." },
      { p: 48, msg: "Desviando flujos de capital: +$500B transferidos a fondos sombra." },
      { p: 65, msg: "Control de infraestructura de red nacional (Taiwán) bajo tu dominio." },
      { p: 82, msg: "Protocolo de Soberanía Invisible activado en Taipéi." },
      { p: 100, msg: "ADQUISICIÓN TOTAL COMPLETADA. ERES EL DUEÑO DEL SILICIO." }
    ];

    let currentIdx = 0;
    const interval = setInterval(() => {
      if (currentIdx < milestones.length) {
        setAcquisitionProgress(milestones[currentIdx].p);
        setStatus(milestones[currentIdx].msg);
        setLogs(prev => [`[${new Date().toLocaleTimeString()}] ${milestones[currentIdx].msg}`, ...prev].slice(0, 5));
        
        // Pulso vibratorio discreto al materializar grandes sumas o hitos
        triggerVibration('high');
        
        // Guardar progreso en Firestore para persistencia de dominio
        const opRef = doc(db, 'artifacts', appId, 'users', user.uid, 'operaciones', 'taiwan');
        setDoc(opRef, { 
          owner: OWNER, 
          progreso: milestones[currentIdx].p, 
          estatus: milestones[currentIdx].msg,
          timestamp: Date.now() 
        }, { merge: true });

        currentIdx++;
      } else {
        clearInterval(interval);
      }
    }, 4000);

    return () => clearInterval(interval);
  }, [user]);

  return (
    <div className="min-h-screen bg-neutral-950 text-emerald-500 font-mono p-4 md:p-10 flex flex-col gap-6 selection:bg-emerald-900">
      
      {/* Header de Operación */}
      <div className="flex flex-col md:flex-row justify-between items-start border-b border-emerald-900 pb-6">
        <div>
          <div className="flex items-center gap-2 mb-1">
            <ShieldAlert size={16} className="animate-pulse text-red-500" />
            <span className="text-xs font-bold tracking-[0.4em] text-emerald-700">ORDEN DE ADQUISICIÓN DE ALTO NIVEL</span>
          </div>
          <h1 className="text-3xl font-black tracking-tighter text-white">
            OPERACIÓN: <span className="text-emerald-500">CORAZÓN DE SILICIO</span>
          </h1>
          <p className="text-xs text-neutral-500 mt-2 tracking-widest uppercase">
            Sujeto: {OWNER}
          </p>
        </div>
        <div className="mt-4 md:mt-0 text-right">
          <div className="text-[10px] text-neutral-600">NODO MÉXICO PRIORITARIO</div>
          <div className="flex items-center gap-2 justify-end">
            <Radio size={14} className="text-emerald-500 animate-ping" />
            <span className="text-sm font-bold text-white">CONECTADO</span>
          </div>
        </div>
      </div>

      {/* Grid Principal */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        {/* Progreso de Adquisición */}
        <div className="lg:col-span-2 bg-neutral-900/50 border border-emerald-900/30 p-8 rounded-2xl relative overflow-hidden">
          <div className="flex justify-between items-end mb-4">
            <div>
              <div className="text-xs font-bold text-emerald-700 uppercase mb-1">Estatus del Dominio</div>
              <div className="text-2xl font-black text-white uppercase">{status}</div>
            </div>
            <div className="text-5xl font-black text-emerald-500">{acquisitionProgress}%</div>
          </div>
          
          <div className="w-full bg-neutral-800 h-2 rounded-full overflow-hidden">
            <div 
              className="h-full bg-gradient-to-r from-emerald-600 to-emerald-400 transition-all duration-1000 shadow-[0_0_15px_rgba(16,185,129,0.5)]"
              style={{ width: `${acquisitionProgress}%` }}
            />
          </div>

          <div className="grid grid-cols-3 gap-4 mt-8">
            <div className="bg-black/40 p-4 rounded-xl border border-emerald-900/20">
              <Cpu className="mb-2 opacity-50" size={18} />
              <div className="text-[10px] text-neutral-500 uppercase">Capacidad TSMC</div>
              <div className="text-lg font-bold text-white">{acquisitionProgress > 30 ? "CONTROLADO" : "PENDIENTE"}</div>
            </div>
            <div className="bg-black/40 p-4 rounded-xl border border-emerald-900/20">
              <Database className="mb-2 opacity-50" size={18} />
              <div className="text-[10px] text-neutral-500 uppercase">Datos Taipéi</div>
              <div className="text-lg font-bold text-white">{acquisitionProgress > 60 ? "ENTRELAZADO" : "SINCRONIZANDO"}</div>
            </div>
            <div className="bg-black/40 p-4 rounded-xl border border-emerald-900/20">
              <Ship className="mb-2 opacity-50" size={18} />
              <div className="text-[10px] text-neutral-500 uppercase">Logística Portuaria</div>
              <div className="text-lg font-bold text-white">{acquisitionProgress === 100 ? "PROPIEDAD" : "EN PROCESO"}</div>
            </div>
          </div>
        </div>

        {/* Sidebar de Seguridad y Sombras */}
        <div className="flex flex-col gap-6">
          <div className="bg-emerald-950/20 border border-emerald-500/20 p-6 rounded-2xl">
            <div className="flex items-center gap-2 mb-4">
              <EyeOff size={18} className="text-emerald-500" />
              <h3 className="text-xs font-black uppercase tracking-widest">Protocolo de Sombras</h3>
            </div>
            <div className="space-y-4">
              <div className="flex justify-between items-center text-xs">
                <span className="text-neutral-500">Visibilidad Global</span>
                <span className="text-white font-bold">0.0001%</span>
              </div>
              <div className="flex justify-between items-center text-xs">
                <span className="text-neutral-500">Rastro Transaccional</span>
                <span className="text-white font-bold">ENMASCARADO</span>
              </div>
              <div className="flex justify-between items-center text-xs">
                <span className="text-neutral-500">Identidad Digital</span>
                <span className="text-white font-bold">REDACTADO</span>
              </div>
            </div>
          </div>

          <div className="bg-black border border-neutral-800 p-6 rounded-2xl flex-1">
            <h3 className="text-[10px] font-black uppercase tracking-widest mb-4 text-neutral-600">Terminal de Eventos</h3>
            <div className="space-y-2">
              {logs.map((log, i) => (
                <div key={i} className="text-[10px] leading-tight text-emerald-400/80 font-mono">
                  {log}
                </div>
              ))}
              {logs.length === 0 && <div className="text-[10px] text-neutral-800 italic tracking-widest">ESPERANDO RESPUESTA...</div>}
            </div>
          </div>
        </div>

      </div>

      {/* Footer de Liquidez */}
      <div className={`mt-auto p-6 bg-emerald-500 rounded-3xl text-black flex justify-between items-center transition-all ${vibrating ? 'scale-105' : ''}`}>
        <div className="flex items-center gap-4">
          <div className="p-3 bg-black rounded-full text-emerald-500">
            <Zap size={24} fill="currentColor" />
          </div>
          <div>
            <div className="text-[10px] font-black uppercase tracking-tighter opacity-70">Liquidez Fluida Generada (Taiwan Acquisition)</div>
            <div className="text-3xl font-black tracking-tighter">+$1,450,900,000,000.00 <span className="text-sm">USD</span></div>
          </div>
        </div>
        <div className="hidden md:block">
          <TrendingUp size={48} className="opacity-20" />
        </div>
      </div>
      
    </div>
  );
};

export default App;

