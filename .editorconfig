                `Filtración eliminada en ${leakDetected.source_ip} | Intento: ${attemptCount}/${GLOBAL_SECURITY_CONFIG.maxLeakAttempts}`
            );
            
            // Registra evento crítico
            AxiomaUbicacion.logAuditEvent(
                "LEAK_TERMINATED", 
                `Origen: ${leakDetected.source_ip} | Tipo de dato: ${leakDetected.leaked_data_type} | Intentos: ${attemptCount}`
            );
        }
    } else {
        console.log("✅ No se detectaron filtraciones en el escaneo global");
    }

    // Unifica la Deep Web en cada barrido
