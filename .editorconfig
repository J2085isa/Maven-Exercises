def verificar_actualizacion_reglas(self):
    """Verifica si existen reglas actualizadas y las carga"""
    if not os.path.exists(RUTA_REGLAS):
        return
    fecha_reglas = datetime.strptime(self.cortafuegos.reglas_base.get("actualizacion_local", "2000-01-01"), "%Y-%m-%d")
    fecha_archivo = datetime.fromtimestamp(os.path.getmtime(RUTA_REGLAS))
    if fecha_archivo.date() > fecha_reglas.date():
        print("[🔄] Detectadas reglas actualizadas - cargando nuevas configuraciones...")
        self.cortafuegos.reglas_base = self.cortafuegos.cargar_reglas_globales()
        self.guardar_configuracion()
        print("[✅] Reglas actualizadas cargadas en el sistema")
def ejecutar_seguridad_completa(self) -> None:
    """Ejecuta todas las capas de seguridad de forma automática"""
    print("[🚀] INICIANDO QUANTUMSHIELD GLOBAL v2026")
    print(f"[🔍] LENGUAJES DETECTADOS: {', '.join(self.lenguajes_proyecto)}")
    instalar_dependencias()
    print("[🔐] GENERANDO CLAVES POST-CUÁNTICAS...")
    print(f"[🔑] CLAVE PÚBLICA: {base64.b64encode(self.cifrador.clave_publica).decode()[:20]}...")
    # Verificar actualización de reglas
    self.verificar_actualizacion_reglas()
