# Entorno unificado: Rust (Cuántico) + Java (Maven/Dubbo) + Python (IA Agent)
FROM debian:bookworm-slim

# Instalación de motores de ejecución
RUN apt-get update && apt-get install -y \
    openjdk-21-jdk \
    rustc cargo \
    python3 pip \
    && rm -rf /var/lib/apt/lists/*

