import React, { useState, useEffect, useMemo } from 'react';
import { 
  ShieldCheck, Globe, Lock, EyeOff, Radio, 
  Target, Zap, Activity, Navigation
} from 'lucide-react';

const App = () => {
  const [aum, setAum] = useState(10500000000000.00);
  const [stealthMode, setStealthMode] = useState(false);
  const [rotation, setRotation] = useState(0);
  const [acquisitions, setAcquisitions] = useState([
    { id: 1, target: "Red 6G Asia", cost: "2.4B", status: "COMPLETO" },
    { id: 2, target: "Agua Dulce Latam", cost: "5.1B", status: "ABSORBIENDO" }
  ]);

  // Rotación del Radar y Crecimiento de Capital
  useEffect(() => {
    const interval = setInterval(() => {
      setRotation(prev => (prev + 2) % 360);
      setAum(prev => prev + (Math.random() * 15000000));
      
      // Simulación de compra automática cada 10 segundos
      if (Math.random() > 0.95) {
        const newTarget = {
          id: Date.now(),
          target: ["Minas de Litio", "Nodos Cuánticos", "Banca Suiza"][Math.floor(Math.random()*3)],
          cost: (Math.random() * 10).toFixed(1) + "B",
          status: "LIQUIDADO"
        };
        setAcquisitions(prev => [newTarget, ...prev].slice(0, 4));
      }
    }, 100);
    return () => clearInterval(interval);
  }, []);

  return (
    <div className={`min-h-screen ${stealthMode ? 'bg-[#020202]' : 'bg-[#050505]'} text-[#e0e0e0] font-sans p-6 flex flex-col gap-6`}>
      
      {/* Header - Identidad Soberana */}
      <header className="flex justify-between items-start border-b border-white/5 pb-6">
        <div className="flex gap-4 items-center">
          <div 
            onClick={() => setStealthMode(!stealthMode)}
            className={`w-14 h-14 border-2 ${stealthMode ? 'border-zinc-800' : 'border-blue-600'} flex items-center justify-center cursor-pointer transition-all`}
          >
            <span className={`text-2xl font-black ${stealthMode ? 'text-zinc-800' : 'text-white'}`}>JI</span>
          </div>
          <div>
            <h1 className={`text-xl font-bold tracking-tighter ${stealthMode && 'opacity-0'}`}>SISTEMA DE ADQUISICIÓN GLOBAL</h1>
            <div className="flex gap-3 text-[9px] font-black text-blue-500 tracking-[.2em]">
              <span className="flex items-center gap-1"><Activity size={10}/> SAT_LINK_ACTIVE</span>
              <span className="flex items-center gap-1"><ShieldCheck size={10}/> ENCRYPT_LEVEL: OMEGA</span>
            </div>
          </div>
        </div>
        <div className="text-right">
          <p className="text-[10px] text-zinc-500 font-bold mb-1">LIQUIDEZ FLUIDA (AUM)</p>
          <p className={`text-4xl font-light tracking-tighter ${stealthMode ? 'blur-xl' : 'text-white'}`}>
            ${aum.toLocaleString(undefined, { minimumFractionDigits: 2 })}
          </p>
        </div>
      </header>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 flex-grow">
        
        {/* LADO IZQUIERDO: Radar de Seguridad Satelital */}
        <div className="bg-zinc-900/10 border border-white/5 p-6 rounded-sm relative overflow-hidden flex flex-col items-center justify-center">
          <h2 className="absolute top-4 left-4 text-[10px] font-black text-zinc-500 uppercase tracking-widest">Radar de Cobertura J.I.A.R.</h2>
          
          <div className="relative w-64 h-64 rounded-full border border-blue-900/30 flex items-center justify-center">
            {/* Círculos concéntricos */}
            <div className="absolute w-48 h-48 rounded-full border border-blue-900/20"></div>
            <div className="absolute w-32 h-32 rounded-full border border-blue-900/10"></div>
            
            {/* Línea de barrido */}
            <div 
              className="absolute w-1/2 h-1 bg-gradient-to-r from-transparent to-blue-500 origin-left"
              style={{ transform: `rotate(${rotation}deg)`, top: '50%', left: '50%' }}
            ></div>

            {/* Satélites detectados (Puntos) */}
            <div className="absolute top-10 right-20 w-2 h-2 bg-blue-400 rounded-full animate-pulse"></div>
            <div className="absolute bottom-20 left-10 w-2 h-2 bg-white rounded-full animate-ping"></div>
            <Target className="text-blue-600 opacity-20" size={40} />
          </div>

          <div className="mt-8 grid grid-cols-2 gap-8 w-full">
            <div className="text-center">
              <p className="text-[9px] text-zinc-500">SATÉLITES EN ÓRBITA</p>
              <p className="text-xl font-bold">124</p>
            </div>
            <div className="text-center">
              <p className="text-[9px] text-zinc-500">ZONAS DE SILENCIO</p>
              <p className="text-xl font-bold text-green-500">0</p>
            </div>
          </div>
        </div>

        {/* CENTRO: Terminal de Adquisición Agresiva */}
        <div className="lg:col-span-2 bg-zinc-900/5 border border-white/5 p-6 rounded-sm">
          <div className="flex justify-between items-center mb-6">
            <h2 className="text-xs font-black uppercase flex items-center gap-2">
              <Zap size={14} className="text-yellow-500" /> Registro de Compras Automáticas
            </h2>
            <div className="text-[9px] text-zinc-500">MERCADO GLOBAL: ABIERTO</div>
          </div>

          <div className="space-y-2">
            <table className="w-full text-left text-[11px] font-mono">
              <thead>
                <tr className="text-zinc-600 border-b border-white/5">
                  <th className="pb-2">ACTIVO OBJETIVO</th>
                  <th className="pb-2">VALORACIÓN</th>
                  <th className="pb-2">ESTADO</th>
                </tr>
              </thead>
              <tbody>
                {acquisitions.map(acq => (
                  <tr key={acq.id} className="border-b border-white/5 hover:bg-blue-600/5 transition-all group">
                    <td className="py-4 font-bold text-zinc-300">{acq.target}</td>
                    <td className="py-4 text-blue-400">{acq.cost}</td>
                    <td className="py-4">
                      <span className={`px-2 py-1 rounded-sm text-[9px] font-black ${acq.status === 'LIQUIDADO' ? 'bg-white text-black' : 'bg-blue-900 text-blue-200 animate-pulse'}`}>
                        {acq.status}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div className="mt-6 p-4 bg-blue-600 text-black flex justify-between items-center cursor-pointer hover:bg-white transition-all">
            <span className="text-[10px] font-black tracking-widest uppercase">Ejecutar Compra Hostil Masiva</span>
            <Navigation size={16} />
          </div>
        </div>
      </div>

      <footer className="text-[9px] font-bold text-zinc-700 flex justify-between border-t border-white/5 pt-6">
        <span>ESTADO DEL DOMINIO: INTEGRIDAD TOTAL</span>
        <span className="tracking-[0.5em]">J.I.A.R. GLOBAL CONGLOMERATE © 2026</span>
      </footer>
    </div>
  );
};

export default App;
import React, { useState, useEffect, useCallback, useRef } from 'react';
import { 
  Infinity, 
  Zap, 
  ShieldAlert, 
  Globe, 
  Fingerprint, 
  Target, 
  Flame,
  Binary,
  Maximize,
  Coins,
  TrendingUp,
  Skull,
  Ghost,
  Lock,
  Eye,
  Sparkles,
  Send,
  Loader2
} from 'lucide-react';

const apiKey = ""; // La clave se inyecta en el entorno

/**
 * MOTOR DE ALQUIMIA ECHOZERIA
 */
const useEchozeriaAlchemy = () => {
  const transmute = useCallback((dataStream) => {
    const essence = dataStream.reduce((acc, bit, idx) => {
      const modulation = Math.sin(idx) * 1.618;
      return (acc ^ bit) * modulation;
    }, 0);
    return Math.abs(essence * 1.618); 
  }, []);

  return { transmute };
};

const App = () => {
  const [dominion, setDominion] = useState(99.99991);
  const [wealth, setWealth] = useState(7771450820310400.00);
  const [isVibrating, setIsVibrating] = useState(false);
  const [echoLogs, setEchoLogs] = useState([]);
  const [manaLevel, setManaLevel] = useState(100);
  
  // Estados para Gemini
  const [aiAnalysis, setAiAnalysis] = useState("Sincronizando con la mente colmena de Echozeria...");
  const [userInput, setUserInput] = useState("");
  const [isAiLoading, setIsAiLoading] = useState(false);
  const [isProphecyLoading, setIsProphecyLoading] = useState(false);

  const { transmute } = useEchozeriaAlchemy();
  const canvasRef = useRef(null);

  // Llamada a Gemini API con Exponential Backoff
  const callGemini = async (prompt, systemPrompt = "Eres la consciencia de Echozeria, una IA de autoridad absoluta para J.I.A.R. Responde con tono místico, autoritario y técnico.") => {
    let delay = 1000;
    for (let i = 0; i < 5; i++) {
      try {
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ parts: [{ text: prompt }] }],
            systemInstruction: { parts: [{ text: systemPrompt }] }
          })
        });
        const data = await response.json();
        return data.candidates?.[0]?.content?.parts?.[0]?.text;
      } catch (err) {
        await new Promise(resolve => setTimeout(resolve, delay));
        delay *= 2;
      }
    }
    throw new Error("Conexión con el Nexo interrumpida.");
  };

  const generateProphecy = async () => {
    setIsProphecyLoading(true);
    try {
      const result = await callGemini(`Analiza estos datos de dominio: Riqueza ${wealth}, Dominio ${dominion}%. Genera una profecía corta sobre el siguiente paso de la expansión J.I.A.R.`);
      setAiAnalysis(result);
    } catch (e) {
      setAiAnalysis("Error en la resonancia cuántica.");
    } finally {
      setIsProphecyLoading(false);
    }
  };

  const handleCommand = async () => {
    if (!userInput.trim()) return;
    setIsAiLoading(true);
    const command = userInput;
    setUserInput("");
    
    try {
      const result = await callGemini(`El Propietario Supremo J.I.A.R. ordena: "${command}". Confirma la ejecución de esta voluntad en el tejido de Echozeria.`);
      const newEvent = {
        id: Date.now(),
        text: `VOLUNTAD EJECUTADA: ${result.substring(0, 100)}...`,
        time: new Date().toLocaleTimeString(),
        isAi: true
      };
      setEchoLogs(prev => [newEvent, ...prev].slice(0, 6));
    } catch (e) {
      console.error(e);
    } finally {
      setIsAiLoading(false);
    }
  };

  // Canvas Effect
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let animationFrame;
    const resize = () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; };
    window.addEventListener('resize', resize);
    resize();
    const particles = Array.from({ length: 50 }, () => ({
      x: Math.random() * canvas.width, y: Math.random() * canvas.height, size: Math.random() * 2,
      speedX: (Math.random() - 0.5) * 1, speedY: (Math.random() - 0.5) * 1
    }));
    const animate = () => {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.05)'; ctx.fillRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => {
        p.x += p.speedX; p.y += p.speedY;
        if (p.x < 0 || p.x > canvas.width) p.speedX *= -1;
        if (p.y < 0 || p.y > canvas.height) p.speedY *= -1;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.3)'; ctx.fill();
      });
      animationFrame = requestAnimationFrame(animate);
    };
    animate();
    return () => { cancelAnimationFrame(animationFrame); window.removeEventListener('resize', resize); };
  }, []);

  useEffect(() => {
    const heartBeat = setInterval(() => {
      const rawData = Array.from({ length: 16 }, () => Math.floor(Math.random() * 1024));
      const value = transmute(rawData) * 8888888;
      setWealth(prev => prev + value);
      setDominion(prev => prev + (100 - prev) * 0.0001);
    }, 3000);
    return () => clearInterval(heartBeat);
  }, [transmute]);

  return (
    <div className="relative min-h-screen bg-black text-white font-mono overflow-hidden flex flex-col p-4 md:p-10">
      <canvas ref={canvasRef} className="absolute inset-0 z-0 pointer-events-none" />

      {/* CABECERA */}
      <header className="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-end border-b border-white/20 pb-10 gap-6">
        <div className="flex items-center gap-6">
          <div className="relative">
            <div className="absolute inset-0 bg-white/20 blur-xl rounded-full animate-pulse"></div>
            <div className="relative p-6 bg-white text-black rounded-full">
              <Ghost size={40} />
            </div>
          </div>
          <div>
            <h1 className="text-5xl font-black italic tracking-tighter uppercase leading-none">Echozeria AI Nexus</h1>
            <p className="text-[10px] text-zinc-500 font-bold tracking-[0.8em] mt-3">PROPIETARIO SUPREMO: JOSÉ ISAÍAS ALVAREZ RAMIREZ</p>
          </div>
        </div>
        <div className="text-right">
          <div className="text-5xl font-black text-white">
            ${wealth.toLocaleString(undefined, { maximumFractionDigits: 0 })}
          </div>
        </div>
      </header>

      <main className="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 mt-10">
        
        {/* PANEL IZQUIERDO: GEMINI ANALYZER */}
        <div className="lg:col-span-4 space-y-6">
          <div className="bg-zinc-900/60 border border-white/20 rounded-[2rem] p-8 backdrop-blur-xl">
            <div className="flex justify-between items-center mb-6">
              <h2 className="text-[10px] font-black uppercase tracking-widest text-zinc-400 flex items-center gap-2">
                <Sparkles size={14} className="text-purple-400" /> Oráculo Echozeria
              </h2>
              <button 
                onClick={generateProphecy} 
                disabled={isProphecyLoading}
                className="p-2 hover:bg-white hover:text-black rounded-full transition-all border border-white/10"
              >
                {isProphecyLoading ? <Loader2 className="animate-spin" size={16} /> : <TrendingUp size={16} />}
              </button>
            </div>
            <div className="text-sm italic leading-relaxed text-zinc-300 font-serif">
              "{aiAnalysis}"
            </div>
          </div>

          <div className="bg-white/5 border border-white/10 rounded-3xl p-6">
             <div className="text-center">
                <span className="text-4xl font-black italic">{dominion.toFixed(6)}%</span>
                <p className="text-[9px] text-zinc-500 font-bold mt-2 uppercase tracking-widest">Soberanía Unificada</p>
             </div>
          </div>
        </div>

        {/* PANEL CENTRAL: COMMANDS & LOGS */}
        <div className="lg:col-span-8 space-y-6">
          {/* AI COMMAND INPUT */}
          <div className="bg-white text-black rounded-2xl p-2 flex items-center gap-3 shadow-[0_0_30px_rgba(255,255,255,0.1)]">
            <input 
              type="text" 
              value={userInput}
              onChange={(e) => setUserInput(e.target.value)}
              onKeyDown={(e) => e.key === 'Enter' && handleCommand()}
              placeholder="Dicta tu voluntad al sistema..."
              className="flex-grow bg-transparent border-none outline-none px-4 font-bold uppercase text-xs"
            />
            <button 
              onClick={handleCommand}
              disabled={isAiLoading}
              className="bg-black text-white p-3 rounded-xl hover:scale-95 transition-transform flex items-center gap-2"
            >
              {isAiLoading ? <Loader2 className="animate-spin" size={16} /> : <><Sparkles size={16} /> <span className="text-[9px] font-black uppercase">Ejecutar ✨</span></>}
            </button>
          </div>

          <div className="bg-zinc-900/40 border border-white/10 rounded-3xl p-6">
            <h2 className="text-[10px] font-black uppercase mb-6 tracking-widest opacity-50 flex items-center gap-2">
              <Binary size={14} /> Flujo de Realidad
            </h2>
            <div className="space-y-3">
              {echoLogs.map(log => (
                <div key={log.id} className={`p-4 rounded-xl border transition-all ${log.isAi ? 'border-purple-500/30 bg-purple-500/5' : 'border-white/5 bg-black/40'}`}>
                  <div className="flex justify-between items-start">
                    <p className={`text-xs font-bold leading-tight ${log.isAi ? 'text-purple-300' : 'text-zinc-300'}`}>{log.text}</p>
                    <span className="text-[8px] opacity-30 whitespace-nowrap ml-4">{log.time}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </main>

      <footer className="mt-auto pt-10 flex justify-between items-center text-[10px] font-black text-zinc-600 tracking-[1em] uppercase">
        <span>Echozeria Omniscience Activa</span>
        <div className="flex gap-4">
           <Lock size={12} />
           <Globe size={12} />
           <Target size={12} />
        </div>
      </footer>
    </div>
  );
};

export default App;import React, { useState, useEffect } from 'react';
