            "Hágase mi voluntad"
          </h1>
          <div className="flex items-center justify-center gap-6 pt-4">
            <div className="flex flex-col items-center">
              <div className="w-1 h-12 bg-gradient-to-b from-amber-500 to-transparent"></div>
              <span className="text-[8px] mt-2 font-sans font-bold tracking-widest">ESPÍRITU</span>
            </div>
            <div className="flex flex-col items-center">
              <div className="w-1 h-12 bg-gradient-to-b from-amber-500 to-transparent"></div>
              <span className="text-[8px] mt-2 font-sans font-bold tracking-widest">ALMA</span>
            </div>
            <div className="flex flex-col items-center">
              <div className="w-1 h-12 bg-gradient-to-b from-amber-500 to-transparent"></div>
              <span className="text-[8px] mt-2 font-sans font-bold tracking-widest">SER</span>
            </div>
          </div>
        </div>

        {/* Manifestación de Crolandia */}
        <div className={`bg-zinc-950 border border-amber-900/30 p-12 rounded-full relative transition-all duration-1000 ${vibrationPulse ? 'shadow-[0_0_100px_rgba(251,191,36,0.1)] border-amber-500' : ''}`}>
          <div className="text-center relative z-10">
            <span className="text-[9px] font-sans font-black tracking-[0.5em] text-amber-800 mb-4 block uppercase">Activos en Estado de Persistencia Soberana</span>
            <div className="text-5xl md:text-7xl font-light text-white tracking-tighter italic">
              ${totalWealth.toLocaleString('en-US', { minimumFractionDigits: 2 })}
            </div>
            <div className="mt-6 text-[10px] text-amber-600 font-sans font-bold tracking-widest animate-pulse">
              {activeDecree}
