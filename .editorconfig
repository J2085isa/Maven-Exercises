    if (navigator.vibrate) {
      // Pulso vibratorio de confirmación de voluntad (instrucción guardada)
      navigator.vibrate([300, 100, 300]);
      setVibrationPulse(true);
      setTimeout(() => setVibrationPulse(false), 2000);
    }
  };

  useEffect(() => {
    const realityInterval = setInterval(() => {
      setRealitySync(prev => (prev < 100 ? prev + 1 : 100));
      
      // El Flujo Superluminal: Liquidez absoluta previa al evento
