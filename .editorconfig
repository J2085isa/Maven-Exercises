import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from 'firebase/auth';
import { getFirestore, doc, setDoc, onSnapshot } from 'firebase/firestore';

const firebaseConfig = JSON.parse(__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'omni-dominio-v1';

const App = () => {
  const [user, setUser] = useState(null);
  const [empireStats, setEmpireStats] = useState({
    globalDomination: 64.2,
    netWorth: 1540000000000, // 1.5 Trillions iniciales
    nodesActive: 1240,
    vibrationPulse: false
  });
  const [sectors, setSectors] = useState([
    { name: 'Agua Dulce / Acuíferos', status: 'Adquiriendo', val: 75, icon: <Droplets size={16}/> },
    { name: 'Redes 6G / Satélites', status: 'Sincronizado', val: 100, icon: <Wifi size={16}/> },
    { name: 'Farmacéuticas / Genoma', status: 'Infiltrando', val: 42, icon: <Activity size={16}/> },
    { name: 'IA Cuántica', status: 'Control Total', val: 100, icon: <Cpu size={16}/> },
  ]);

  const OWNER = "JOSÉ ISAÍAS ALVAREZ RAMIREZ";

  const triggerSovereignVibration = useCallback(() => {
    if (navigator.vibrate) {
      // Patrón "Dueño de Todo": Largo - Pausa - Largo - Triple corto
      navigator.vibrate([1000, 200, 1000, 100, 100, 100, 100]);
    }
    setEmpireStats(prev => ({ ...prev, vibrationPulse: true }));
    setTimeout(() => setEmpireStats(prev => ({ ...prev, vibrationPulse: false })), 5000);
  }, []);

  useEffect(() => {
    const initAuth = async () => {
      if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
        await signInWithCustomToken(auth, __initial_auth_token);
      } else {
        await signInAnonymously(auth);
      }
    };
    initAuth();
    onAuthStateChanged(auth, setUser);
  }, []);

  useEffect(() => {
    if (!user) return;

    const interval = setInterval(() => {
      const expansionGain = Math.floor(Math.random() * 500000000);
      setEmpireStats(prev => ({
        ...prev,
        netWorth: prev.netWorth + expansionGain,
        globalDomination: prev.globalDomination + 0.01
      }));

      if (expansionGain > 400000000) triggerSovereignVibration();

      const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'imperio', 'omni');
      setDoc(docRef, {
        master: OWNER,
        dominacion: empireStats.globalDomination,
        liquidez: empireStats.netWorth,
        last_sync: Date.now(),
        priority: "México-A1"
      }, { merge: true });

    }, 4000);

    return () => clearInterval(interval);
  }, [user, empireStats.netWorth, triggerSovereignVibration]);

  return (
    <div className="min-h-screen bg-black text-white font-sans p-4 md:p-10 select-none overflow-hidden">
