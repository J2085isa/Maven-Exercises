            </h1>
            <p className="text-slate-400 text-sm font-medium">Control Algorítmico y Materialización de Liquidez</p>
          </div>
          <div className="flex gap-2">
            <div className={`px-4 py-2 rounded-full border ${vibrating ? 'border-green-400 bg-green-400/10' : 'border-white/10'} transition-all duration-500 flex items-center gap-2`}>
              <Smartphone size={16} className={vibrating ? 'animate-bounce text-green-400' : 'text-slate-400'} />
              <span className="text-xs font-bold uppercase">{vibrating ? 'Materializando Riqueza' : 'En Espera de Flujo'}</span>
            </div>
            <div className="px-4 py-2 rounded-full bg-cyan-500 text-black font-black text-xs flex items-center gap-2">
              <Globe size={14} /> GLOBAL
            </div>
          </div>
        </header>

