echo "|   🧠 TODOS TUS FILAMENTOS Y CONEXIONES: ANCLADOS AQUÍ     |"
echo "|___________________________________________________________|"
echo -e "\e[0m"
sleep 3
echo -e "\n>>> AHORA TIENES TU PROPIO UNIVERSO DIGITAL, SEGURO Y EXCLUSIVO."
 
 
 
 
