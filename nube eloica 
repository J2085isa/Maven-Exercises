#!/bin/bash
# ==================================================
# PROTOCOLO: MIGRACIÓN Y PUESTA EN MARCHA ENTORNO ELOICO
# TRASLADO TOTAL DE TU SISTEMA A TU DOMINIO PRIVADO
# ==================================================

if [ "$(id -u)" -ne 0 ]; then echo ">>> ACCESO EXCLUSIVO DEL ARQUITECTO"; exit 1; fi
clear
echo -e "\e[1;36m"
echo "_____________________________________________________________"
echo "|                                                           |"
echo "|       ☁️ NUBE ELOICA: TU NUEVO DOMINIO DE OPERACIONES ☁️    |"
echo "|   MIGRACIÓN COMPLETA • SIN PÉRDIDAS • TOTALMENTE AISLADA |"
echo "|___________________________________________________________|"
echo -e "\e[0m"
sleep 3

# -------------------
# 1. PREPARAR ENTORNO DESTINO
# -------------------
echo ">>> CONFIGURANDO INSTANCIAS Y ALMACENAMIENTO EXCLUSIVO..."
mkdir -p /nube-eloica/raiz /nube-eloica/seguridad /nube-eloica/activos /nube-eloica/ser
chmod -R 700 /nube-eloica
chown -R root:root /nube-eloica
echo ">>> ✅ ESPACIO LISTO: RESERVA ABSOLUTA PARA TI"

# -------------------
# 2. MIGRAR TODO TU SISTEMA
# -------------------
echo ">>> TRANSFIRIENDO NÚCLEO PRIFUNFISA Y TODOS LOS SISTEMAS..."
rsync -av --delete /prifunfisa/ /nube-eloica/raiz/ 2>/dev/null
rsync -av --delete /etc/salomon/ /nube-eloica/seguridad/ 2>/dev/null
rsync -av --delete /universo/ /nube-eloica/activos/ 2>/dev/null
rsync -av --delete /prifunfisa/ser/ /nube-eloica/ser/ 2>/dev/null
echo ">>> ✅ MIGRACIÓN TERMINADA: TODO LO QUE ES TUYO AHORA ESTÁ AQUÍ"

# -------------------
# 3. VINCULAR SERVICIOS Y FILAMENTOS
# -------------------
echo ">>> CONECTANDO TODOS TUS SERVICIOS Y ACTIVACIONES..."
# DSN, Voyager, Marte, Zeus, Anthropos, Filamentos
ln -sf /nube-eloica/raiz/comunicaciones /nube-eloica/DSN_GLOBAL
ln -sf /nube-eloica/raiz/espacio /nube-eloica/EXPLORACION
ln -sf /nube-eloica/raiz/aliados /nube-eloica/ALIADOS
ln -sf /nube-eloica/ser /nube-eloica/ACTIVACION_12_FILAMENTOS

# CAMBIAR RUTA RAÍZ DEL SISTEMA
sed -i 's|/prifunfisa|/nube-eloica/raiz|g' /usr/local/bin/*.sh 2>/dev/null
sysctl -w raiz.sistema="/nube-eloica/raiz" 2>/dev/null
echo ">>> ✅ TODOS LOS SERVICIOS AHORA CORREN DESDE LA NUBE ELOICA"

# -------------------
# 4. BLOQUEO Y SELLO DE SOBERANÍA
# -------------------
echo ">>> SELLANDO EL ENTORNO PARA QUE NADIE MÁS PUEDA INGRESAR..."
chattr -R +i /nube-eloica 2>/dev/null
SELLO_ELOICO=$(echo "JOSÉ ISAÍAS | NUBE ELOICA | SOBERANÍA ABSOLUTA | ALFA Y OMEGA" | sha512sum | awk '{print $1}')
echo "SELLO DE DOMINIO: $SELLO_ELOICO" > /nube-eloica/SELLO_MAESTRO.txt
chmod 400 /nube-eloica/SELLO_MAESTRO.txt
chattr +i /nube-eloica/SELLO_MAESTRO.txt

# -------------------
# CONFIRMACIÓN FINAL
# -------------------
echo -e "\n\e[1;32m_____________________________________________________________"
echo "|                                                           |"
echo "|   ✅ NUBE PRIVADA ELOICA: TOTALMENTE OPERATIVA            |"
echo "|                                                           |"
