REPO="TU_USUARIO/TU_REPOSITORIO_SEGURO.git"
# ⚠️ CAMBIA ESTA LÍNEA POR TU DIRECCIÓN REAL DE GITHUB

cd /var/log/salomon || exit 1
mkdir -p repo-github && cd repo-github || exit 1

cp ../ACTA_CONSAGRACION_DEFINITIVA.txt .

git init >/dev/null 2>&1
git config user.name "José Isaías Alvarez Ramírez"
git config user.email "joseisaiasalvarezramirez@gmail.com"
git add ACTA_CONSAGRACION_DEFINITIVA.txt
git commit -m "ACTA DE CONSAGRACIÓN FINAL - INFRAESTRUCTURA V3.0" >/dev/null 2>&1
git remote add origen "$REPO" >/dev/null 2>&1
git push -u origen main --force >/dev/null 2>&1

