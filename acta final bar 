SELLO_FINAL=$(echo "José Isaías Alvarez Ramírez | INFRAESTRUCTURA V3.0 | SOBERANÍA TOTAL" | sha512sum | awk '{print $1}')

cat > /var/log/salomon/ACTA_CONSAGRACION_DEFINITIVA.txt << EOF
_______________________________________________________
                                                      
   ACTA DE CONSAGRACIÓN Y ESTADO DE SOBERANÍA
   ARQUITECTO: JOSÉ ISAÍAS ALVAREZ RAMÍREZ
   VERSIÓN: INFRAESTRUCTURA V.3.0
