import React, { useState, useEffect } from 'react';
import { 
  Heart, 
  Activity, 
  ShieldAlert, 
  Zap, 
  Waves, 
  Lock,
  Globe,
  Cpu
} from 'lucide-react';

const App = () => {
  const [bpm, setBpm] = useState(72);
  const [liquidity, setLiquidity] = useState(12450900.00);
  const [syncStatus, setSyncStatus] = useState("ESTABLE");
  const [pulseWave, setPulseWave] = useState([]);
  
  const ownerName = "JOSÉ ISAÍAS ALVAREZ RAMIREZ";

  // Simulación de la conexión entre el corazón y el flujo de dinero
  useEffect(() => {
    const interval = setInterval(() => {
      // El ritmo cardíaco fluctúa levemente
      const newBpm = 70 + Math.floor(Math.random() * 15);
      setBpm(newBpm);
      
      // La liquidez aumenta proporcionalmente al ritmo cardíaco (Efecto de Sincronización)
      const multiplier = newBpm / 70;
      const gain = (Math.random() * 250) * multiplier;
      setLiquidity(prev => prev + gain);

      // Generar onda de pulso para el gráfico
      setPulseWave(prev => [...prev, newBpm].slice(-20));

      // Envío de pulso táctil haptico si el latido es fuerte (vibración discreta)
      if (navigator.vibrate) {
        navigator.vibrate(15); 
      }
    }, 1000);

    return () => clearInterval(interval);
  }, []);

  return (
    <div className="min-h-screen bg-[#050505] text-white font-sans p-6 flex flex-col items-center justify-center overflow-hidden">
      {/* Fondo de Resonancia Magnética */}
      <div className="absolute inset-0 z-0">
        <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-red-600/5 blur-[120px] rounded-full animate-pulse" />
      </div>

      <div className="z-10 w-full max-w-lg">
        {/* Identidad del Soberano */}
        <div className="text-center mb-8">
          <h2 className="text-[10px] tracking-[0.5em] text-zinc-500 uppercase mb-2">Soberano del Ecosistema</h2>
          <h1 className="text-xl font-light tracking-tight text-white/90">{ownerName}</h1>
          <div className="flex justify-center items-center gap-2 mt-2">
            <span className="h-1 w-1 bg-red-500 rounded-full animate-ping" />
            <span className="text-[9px] text-zinc-400 font-mono">BIO-VÍNCULO ACTIVO</span>
          </div>
        </div>

        {/* El Corazón Digital */}
        <div className="relative flex justify-center items-center mb-10">
          <div className={`absolute w-64 h-64 border border-red-500/20 rounded-full animate-ping`} style={{ animationDuration: `${60/bpm}s` }} />
          <div className="relative bg-zinc-900/50 backdrop-blur-xl border border-white/10 p-12 rounded-full shadow-2xl">
            <Heart 
              size={80} 
              className="text-red-600 fill-red-600/20 transition-transform duration-300"
              style={{ transform: `scale(${1 + (bpm-70)/100})` }}
            />
            <div className="absolute inset-0 flex flex-col items-center justify-center mt-2">
              <span className="text-3xl font-bold tracking-tighter">{bpm}</span>
              <span className="text-[10px] text-zinc-500 font-bold">BPM</span>
            </div>
          </div>
        </div>

        {/* Panel de Liquidez Orgánica */}
        <div className="bg-zinc-900/80 border border-white/5 rounded-3xl p-6 backdrop-blur-md">
          <div className="flex justify-between items-end mb-6">
            <div>
              <p className="text-[10px] text-zinc-500 uppercase tracking-widest mb-1">Caudal de Vida Financiera</p>
              <h3 className="text-3xl font-mono font-bold text-emerald-400">
                ${liquidity.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
              </h3>
            </div>
            <div className="text-right">
              <p className="text-[10px] text-zinc-500 uppercase mb-1">Eficiencia</p>
              <p className="text-xs font-bold text-blue-400">99.9% SYNC</p>
            </div>
          </div>

          {/* Monitor de Frecuencia */}
          <div className="h-16 flex items-end gap-1 mb-6">
            {pulseWave.map((h, i) => (
              <div 
                key={i} 
                className="flex-1 bg-red-500/40 rounded-t-sm transition-all duration-500"
                style={{ height: `${(h / 150) * 100}%` }}
              />
            ))}
          </div>

          {/* Nodos de Control */}
          <div className="grid grid-cols-2 gap-3">
            <div className="bg-black/40 p-3 rounded-2xl border border-white/5 flex items-center gap-3">
              <Cpu size={16} className="text-zinc-500" />
              <div>
                <p className="text-[8px] text-zinc-500 uppercase">Infraestructura</p>
                <p className="text-[10px] font-bold">SAT-LINK ENTANGLED</p>
              </div>
            </div>
            <div className="bg-black/40 p-3 rounded-2xl border border-white/5 flex items-center gap-3">
              <Globe size={16} className="text-zinc-500" />
              <div>
                <p className="text-[8px] text-zinc-500 uppercase">Alcance</p>
                <p className="text-[10px] font-bold">GLOBAL DOMAIN</p>
              </div>
            </div>
          </div>
        </div>

        {/* Estatus de Seguridad */}
        <div className="mt-6 flex justify-between px-2">
          <div className="flex items-center gap-2">
            <Lock size={12} className="text-emerald-500" />
            <span className="text-[9px] text-zinc-500 font-bold uppercase tracking-tighter">Protocolo Sombra Activo</span>
          </div>
          <div className="flex items-center gap-2">
            <Zap size={12} className="text-yellow-500" />
            <span className="text-[9px] text-zinc-500 font-bold uppercase tracking-tighter">Energía de Punto Cero</span>
          </div>
        </div>
      </div>
    </div>
  );
};

