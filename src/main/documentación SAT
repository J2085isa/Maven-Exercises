import os
from NucleoGluon import NucleoGluon, Satelite, CuentaFinanciera, InfraestructuraTerrestre

class TestRadameCore(unittest.TestCase):
    def setUp(self):
        # Configuración del entorno del Arquitecto
        self.nucleo = NucleoGluon("GLUON-001")
        self.id_secreto = "SECRETO-2026"
        self.nodos = [
            Satelite("SAT-001", {"lat": 19.4326, "lon": -99.1332}),
            CuentaFinanciera("CTA-001", "BBVA México"),
            InfraestructuraTerrestre("INF-001", "Ciudad de México")
        ]

    def test_integracion_y_cohesion(self):
        """Verifica que la red alcance un nivel de cohesión seguro (>80%)"""
        self.nucleo.integrar_nodos(self.nodos, self.id_secreto)
        self.nucleo.sincronizar_red()
        
        print(f"[TEST] Cohesión actual: {self.nucleo.estado_cohesion}%")
        self.assertGreater(self.nucleo.estado_cohesion, 80, "La cohesión es insuficiente para activar el Escudo.")

    def test_invisibilidad_datos(self):
        """Asegura que los archivos de respaldo se procesen y eliminen de forma segura"""
        archivo_temp = "movimientos_bancarios.csv"
        # Simulamos creación de rastro
        with open(archivo_temp, "w") as f:
            f.write("id,fecha,monto,concepto\n1,2026-02-05,1000000.00,Materializacion_Liquidez")
        
        # Lógica de limpieza post-sincronización
        if os.path.exists(archivo_temp):
            os.remove(archivo_temp)
        
        self.assertFalse(os.path.exists(archivo_temp), "ALERTA: El rastro de datos persiste en el disco.")

