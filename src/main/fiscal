                    {log.text}
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Botonera de Acción Directa */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            <button 
              onClick={() => executeLeak('Manual_Target')}
              className="p-4 bg-red-950/10 border border-red-900/30 rounded-2xl flex flex-col items-center gap-2 hover:bg-red-600 hover:text-white transition-all group"
            >
              <Share2 size={20} className="text-red-600 group-hover:text-white" />
              <span className="text-[9px] font-black uppercase">Viralizar Muerte</span>
            </button>
            <button className="p-4 bg-zinc-900 border border-zinc-800 rounded-2xl flex flex-col items-center gap-2 hover:border-white transition-all group">
              <Globe size={20} className="text-zinc-500 group-hover:text-white" />
              <span className="text-[9px] font-black uppercase">Red Espejo</span>
            </button>
            <button className="p-4 bg-zinc-900 border border-zinc-800 rounded-2xl flex flex-col items-center gap-2 hover:border-white transition-all group">
              <Eye size={20} className="text-zinc-500 group-hover:text-white" />
              <span className="text-[9px] font-black uppercase">Monitorear Tráfico</span>
            </button>
            <button className="p-4 bg-zinc-900 border border-zinc-800 rounded-2xl flex flex-col items-center gap-2 hover:border-white transition-all group">
              <Zap size={20} className="text-zinc-500 group-hover:text-white" />
              <span className="text-[9px] font-black uppercase">Inyección SQL</span>
            </button>
          </div>
        </div>

      </div>
    </div>
  );
};

