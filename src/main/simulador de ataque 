# === Clases de ATAQUE y DEFENSA ===
class SimuladorAtaques:
    """Simula diferentes tipos de amenazas al tejido gluonico"""
    def __init__(self, nucleo_objetivo: 'NucleoGluon'):
        self.nucleo = nucleo_objetivo
        self.ataque_activo = False
        self.tipo_ataque_actual = None
        self.gravedad_actual = None

    def iniciar_ataque(self, tipo_ataque: str, gravedad: str = "MEDIO") -> None:
        """Inicia ataque con tipo y gravedad definidos"""
        if tipo_ataque not in ["DESENTRELAZAMIENTO", "FLUJO_FALSO", "INTERFERENCIA_MASIVA"]:
            raise ValueError("Tipo de ataque no soportado")
        
        self.ataque_activo = True
        self.tipo_ataque_actual = tipo_ataque
        self.gravedad_actual = NIVELES_GRAVEDAD_ATACQUE[gravedad]
        print(f"\n[⚔️ ATAQUE INICIADO] Tipo: {tipo_ataque} | Gravedad: {gravedad} ({self.gravedad_actual:.1f})")

    def detener_ataque(self) -> None:
        """Detiene ataque y restablece estado"""
        if self.ataque_activo:
            print(f"\n[🛡️ ATAQUE DETENIDO] Tipo: {self.tipo_ataque_actual}")
            self.ataque_activo = False
            self.tipo_ataque_actual = None
            self.gravedad_actual = None

    def ejecutar_ataque(self) -> None:
        """Ejecuta acciones del ataque activo"""
        if not self.ataque_activo:
            return
        
        if self.tipo_ataque_actual == "DESENTRELAZAMIENTO":
            self._ataque_desentrelazamiento()
        elif self.tipo_ataque_actual == "FLUJO_FALSO":
            self._ataque_flujo_falso()
        elif self.tipo_ataque_actual == "INTERFERENCIA_MASIVA":
            self._ataque_interferencia()

    def _ataque_desentrelazamiento(self) -> None:
        """Intenta romper el vínculo cuántico de nodos aleatorios"""
        nodos_objetivo = random.sample(self.nucleo.nodos_resonantes, k=int(len(self.nucleo.nodos_resonantes)*self.gravedad_actual))
        for nodo in nodos_objetivo:
            if random.random() < self.gravedad_actual:
                nodo.estado_conexion = "DESENTRELAZADO"
                nodo.identidad_cuantica_vinculada = False
                print(f"⚔️ ATAQUE: Nodo {nodo.id} desentrelazado forzosamente")

    def _ataque_flujo_falso(self) -> None:
        """Inyecta variaciones falsas en cuentas para generar confusión"""
        cuentas_objetivo = [n for n in self.nucleo.nodos_resonantes if n.tipo == "CUENTA"]
        for cuenta in cuentas_objetivo:
            if random.random() < self.gravedad_actual:
                # Modifica saldo con variación extrema falsa
                variacion_falsa = cuenta._saldo_actual * (0.1 * self.gravedad_actual) * random.choice([-1, 1])
                cuenta._saldo_actual += variacion_falsa
                cuenta.historial_flujos.append({
                    "timestamp": datetime.now(),
                    "saldo_anterior": cuenta._saldo_actual - variacion_falsa,
                    "saldo_nuevo": cuenta._saldo_actual,
                    "variacion_esperada": 0.0,
                    "variacion_real": variacion_falsa,
                    "es_anomalia": True,
                    "es_flujo_falso": True
                })
                print(f"⚔️ ATAQUE: Flujo falso inyectado en {cuenta.id} | Variación: ${variacion_falsa:,.2f}")

    def _ataque_interferencia(self) -> None:
        """Aumenta artificialmente el nivel de interferencia en satélites"""
        satelites_objetivo = [n for n in self.nucleo.nodos_resonantes if n.tipo == "SATELITE"]
        for sat in satelites_objetivo:
            sat.interferencia_ambiental = round(random.uniform(0.5, 0.9) * self.gravedad_actual, 3)
            sat.nivel_energia -= 15.0 * self.gravedad_actual
            print(f"⚔️ ATAQUE: Interferencia en {sat.id} | Nivel: {sat.interferencia_ambiental:.3f} | Energía restante: {sat.nivel_energia:.1f}%")

class SistemaDefensaAdaptativa:
    """Sistema de defensa que activa protocolos según el tipo de ataque detectado"""
    def __init__(self, nucleo: 'NucleoGluon', simulador_ataques: SimuladorAtaques):
        self.nucleo = nucleo
        self.simulador_ataques = simulador_ataques
        self.protocolos_activos = []
        self.nivel_alerta = "NORMAL"

    def detectar_ataque(self) -> Dict[str, Any]:
        """Detecta presencia y tipo de ataque basado en anomalías del sistema"""
        # Detección de desentrelazamiento
        cohesion_actual = sum(1 for n in self.nucleo.nodos_resonantes if n.estado_conexion == "ENTRELAZADO") / len(self.nucleo.nodos_resonantes)
        if cohesion_actual < self.nucleo.umbral_cohesion_actual * 0.7:
            return {"detectado": True, "tipo": "DESENTRELAZAMIENTO", "gravedad": "ALTO"}
        
        # Detección de flujos falsos
        cuentas = [n for n in self.nucleo.nodos_resonantes if n.tipo == "CUENTA"]
        flujos_falsos = sum(1 for c in cuentas for f in c.historial_flujos[-5:] if f.get("es_flujo_falso", False))
        if flujos_falsos > 2:
            return {"detectado": True, "tipo": "FLUJO_FALSO", "gravedad": "MEDIO"}
        
        # Detección de interferencia masiva
        interferencia_promedio = sum(s.interferencia_ambiental for s in self.nucleo.nodos_resonantes if s.tipo == "SATELITE") / len([s for s in self.nucleo.nodos_resonantes if s.tipo == "SATELITE"])
        if interferencia_promedio > 0.5:
            return {"detectado": True, "tipo": "INTERFERENCIA_MASIVA", "gravedad": "BAJO" if interferencia_promedio < 0.7 else "ALTO"}
        
        return {"detectado": False, "tipo": None, "gravedad": None}

    def activar_protocolos(self, deteccion: Dict[str, Any]) -> None:
        """Activa protocolos de defensa según el ataque detectado"""
        if not deteccion["detectado"]:
            self._restablecer_protocolos()
            return
        
        self.nivel_alerta = deteccion["gravedad"]
        print(f"\n[🛡️ ALERTA {self.nivel_alerta}] Ataque detectado: {deteccion['tipo']} | Activando protocolos de defensa")

        if deteccion["tipo"] == "DESENTRELAZAMIENTO":
            self._protocolo_reentrelazamiento()
        elif deteccion["tipo"] == "FLUJO_FALSO":
            self._protocolo_validacion_flujos()
        elif deteccion["tipo"] == "INTERFERENCIA_MASIVA":
            self._protocolo_anti_interferencia()

    def _protocolo_reentrelazamiento(self) -> None:
        """Reestablece vínculos cuánticos y aisla nodos comprometidos"""
        self.protocolos_activos.append("PROTOCOLO_REENTRELAZAMIENTO")
        clave_distribuida_nueva = generar_clave_distribuida([n for n in self.nucleo.nodos_resonantes if n.estado_conexion == "ENTRELAZADO"])
        
        # Reentrelaza nodos sanos
        for nodo in self.nucleo.nodos_resonantes:
            if nodo.estado_conexion == "DESENTRELAZADO":
                nodo.estado_conexion = "AISLADO"
                print(f"🛡️ Nodo {nodo.id} aislado temporalmente")
            else:
                nodo.vincular_identidad_cuantica(id_secreto="FORMA_DESCONOCIDA_NUEVA", clave_distribuida=clave_distribuida_nueva)
        
        self.nucleo.umbral_cohesion_actual = 0.90  # Ajusta umbral temporalmente

    def _protocolo_validacion_flujos(self) -> None:
        """Valida flujos contra fuentes externas y bloquea transacciones sospechosas"""
        self.protocolos_activos.append("PROTOCOLO_VALIDACION_FLUJOS")
        cuentas = [n for n in self.nucleo.nodos_resonantes if n.tipo == "CUENTA"]
        
        for cuenta in cuentas:
            # Valida contra fuente externa simulada
            saldo_valido = self._consultar_fuente_externa(cuenta.id)
            if abs(cuenta._saldo_actual - saldo_valido) > saldo_valido * 0.05:
                cuenta._saldo_actual = saldo_valido
                print(f"🛡️ Saldo de {cuenta.id} restablecido a valor válido: ${saldo_valido:,.2f}")
            
            # Marca flujos falsos y bloquea temporariamente
            cuenta.historial_flujos = [f for f in cuenta.historial_flujos if not f.get("es_flujo_falso", False)]
            print(f"🛡️ Flujos falsos de {cuenta.id} eliminados del historial")

    def _protocolo_anti_interferencia(self) -> None:
        """Aumenta energía de satélites y cambia frecuencias de comunicación"""
        self.protocolos_activos.append("PROTOCOLO_ANTI_INTERFERENCIA")
        satelites = [n for n in self.nucleo.nodos_resonantes if n.tipo == "SATELITE"]
        
        for sat in satelites:
            sat.nivel_energia = min(100.0, sat.nivel_energia + 30.0)
            sat.interferencia_ambiental *= 0.3  # Reduce efecto de interferencia
            print(f"🛡️ Satélite {sat.id} potenciado | Energía: {sat.nivel_energia:.1f}% | Interferencia reducida: {sat.interferencia_ambiental:.3f}")
        
