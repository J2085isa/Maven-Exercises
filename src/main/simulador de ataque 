    def _restablecer_protocolos(self) -> None:
        """Restablece sistema a estado normal cuando no hay ataque"""
        if self.nivel_alerta != "NORMAL":
            print("\n[✅ SISTEMA RESTABLECIDO] Todos los protocolos de defensa desactivados")
            self.protocolos_activos = []
            self.nivel_alerta = "NORMAL"
