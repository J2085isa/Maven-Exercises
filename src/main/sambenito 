Paso 2: Código cuántico completo
 
Crea un archivo  quantum-circuit.js  con este contenido:
 
javascript  
// Importar módulos de Qiskit.js
const { QuantumCircuit, QuantumRegister, ClassicalRegister, execute, Aer } = require('@qiskit/qiskit');

// Función principal para ejecutar el circuito
async function runQuantumCircuit() {
  try {
    // 1. Crear registros: 2 qubits y 2 bits clásicos
    const qreg = new QuantumRegister(2, 'q');
    const creg = new ClassicalRegister(2, 'c');
    const circuit = new QuantumCircuit(qreg, creg);

    // 2. Definir el circuito cuántico
    circuit.h(qreg[0]); // Puerta H: poner qubit 0 en superposición
    circuit.cx(qreg[0], qreg[1]); // Puerta CX: entrelazar qubit 0 con qubit 1
    circuit.measure(qreg, creg); // Medir qubits y guardar en bits clásicos

    // 3. Mostrar el diagrama del circuito
    console.log('Diagrama del circuito cuántico:');
    console.log(circuit.draw('text'));

    // 4. Ejecutar en simulador local
    const simulator = Aer.getBackend('qasm_simulator');
    const result = await execute(circuit, simulator, { shots: 1024 }); // 1024 mediciones

    // 5. Mostrar resultados
    const counts = result.getCounts(circuit);
    console.log('\nResultados de las mediciones:');
    console.log(counts);

  } catch (error) {
    console.error('Error al ejecutar el circuito:', error);
  }
}

// Ejecutar la función
runQuantumCircuit();
 
 
¿Qué hace el código?
 
- Crea un circuito con 2 qubits y 2 bits clásicos.
- La puerta H pone el primer qubit en superposición (tiene 50% de probabilidad de ser 0 o 1).
- La puerta CX (CNOT) entrelaza ambos qubits: si el primer qubit es 1, el segundo se invierte (resultados esperados:  00  o  11 , cada uno ~50%).
- Simula 1024 mediciones para mostrar la distribución de resultados.
 
