Alternativa sin instalación (en navegador)
 
Puedes probarlo en el navegador usando el CDN de Qiskit.js. Crea un archivo  index.html :
 
html  
<!DOCTYPE html>
<html>
<body>
  <pre id="output"></pre>
  <script src="https://cdn.jsdelivr.net/npm/@qiskit/qiskit@0.4.2/dist/qiskit.min.js"></script>
  <script>
    async function run() {
      const { QuantumCircuit, QuantumRegister, ClassicalRegister, execute, Aer } = Qiskit;
      const qreg = new QuantumRegister(2, 'q');
      const creg = new ClassicalRegister(2, 'c');
      const circuit = new QuantumCircuit(qreg, creg);
      
      circuit.h(qreg[0]);
      circuit.cx(qreg[0], qreg[1]);
      circuit.measure(qreg, creg);

      const output = document.getElementById('output');
      output.textContent += 'Diagrama:\n' + circuit.draw('text') + '\n\n';

      const sim = Aer.getBackend('qasm_simulator');
      const res = await execute(circuit, sim, { shots: 1024 });
      output.textContent += 'Resultados:\n' + JSON.stringify(res.getCounts(circuit));
    }
    run();
  </script>
</body>
</html>
 
 
