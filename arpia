SERVICIOS_CLOUD=("azure.com" "googleapis.com" "amazonaws.com")

for servicio in "${SERVICIOS_CLOUD[@]}"; do
    if ! curl -s --head "$servicio" | grep "200 OK" > /dev/null; then
        echo -e "\033[1;31m[!] ANOMALÍA EN $servicio - Comunicación interrumpida\033[0m"
        echo "[$(date +%T)] ANOMALÍA CLOUD: $servicio no accesible" >> "$LOG_ARPIA"
