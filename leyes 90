ARCHIVO_PRINCIPAL="$RUTA_SISTEMA/codigo_salomon_principal.sh"
LOG_ACTIVACION="$RUTA_SISTEMA/logs/activacion.log"

# Colores
ROJO='\033[91m'
VERDE='\033[92m'
AMARILLO='\033[93m'
AZUL='\033[94m'
MORADO='\033[95m'
CIAN='\033[96m'
BLANCO='\033[97m'
FIN='\033[0m'

# ─────────────────────────────────────────────────────────────────────
# FUNCIONES DE APOYO
# ─────────────────────────────────────────────────────────────────────
function fecha_hora {
    date +"%d/%m/%Y %H:%M:%S"
}

function registrar {
    local TIPO="$1"
    local MENSAJE="$2"
    echo "[$(fecha_hora)] [$TIPO] $MENSAJE" >> "$LOG_ACTIVACION"
}

function mostrar_mensaje {
    local COLOR="$1"
    local TEXTO="$2"
    echo -e "${COLOR}$TEXTO${FIN}"
}

function verificar_comando {
    local NOMBRE="$1"
    if command -v "$NOMBRE" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

# ─────────────────────────────────────────────────────────────────────
# PASO 1: VERIFICAR ENTORNO Y HERRAMIENTAS
# ─────────────────────────────────────────────────────────────────────
function verificar_entorno {
    mostrar_mensaje "$AZUL" "════════════════════════════════════════════════════════════════"
    mostrar_mensaje "$BLANCO" " PASO 1: VERIFICACIÓN DE ENTORNO Y HERRAMIENTAS"
    mostrar_mensaje "$AZUL" "════════════════════════════════════════════════════════════════"
    registrar "ACTIVACIÓN" "Iniciando verificación de entorno"

    # Comprobación de herramientas básicas
    HERRAMIENTAS=("bash" "pkg" "dpkg" "sleep" "date" "sha256sum")
    FALTANTES=()

    for HERRAMIENTA in "${HERRAMIENTAS[@]}"; do
        if ! verificar_comando "$HERRAMIENTA"; then
            FALTANTES+=("$HERRAMIENTA")
        fi
    done

    if [ ${#FALTANTES[@]} -gt 0 ]; then
        mostrar_mensaje "$AMARILLO" "[!] Algunas herramientas faltan. Instalando..."
        registrar "ACTIVACIÓN" "Instalando herramientas faltantes: ${FALTANTES[*]}"
        
        pkg update -y >/dev/null 2>&1
        pkg install -y bash coreutils procps openssl util-linux >/dev/null 2>&1
        
        if [ $? -eq 0 ]; then
            mostrar_mensaje "$VERDE" "[✓] Entorno preparado correctamente"
            registrar "ACTIVACIÓN" "Entorno preparado y listo"
        else
            mostrar_mensaje "$ROJO" "[✗] No se pudo preparar el entorno. Verifica la conexión."
            registrar "ERROR" "Fallo al preparar el entorno"
            exit 1
        fi
    else
        mostrar_mensaje "$VERDE" "[✓] Entorno correcto y funcional"
        registrar "ACTIVACIÓN" "Entorno verificado correctamente"
    fi
    echo ""
}

# ─────────────────────────────────────────────────────────────────────
# PASO 2: CREAR ESTRUCTURA Y COPIAR ARCHIVOS
