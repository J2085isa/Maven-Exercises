    # Crear carpetas con permisos seguros
    mkdir -p "$RUTA_SISTEMA"/{logs,seguridad,configuracion,almacenamiento} 2>/dev/null
    chmod 700 "$RUTA_SISTEMA"

    for DIR in "$RUTA_SISTEMA"/*; do
        chmod 700 "$DIR" 2>/dev/null
    done

    # Crear archivo de configuración básico
    if [ ! -f "$RUTA_SISTEMA/configuracion/parametros.dat" ]; then
        cat > "$RUTA_SISTEMA/configuracion/parametros.dat" << EOF
VERSION=9.0 BASH EDITION
