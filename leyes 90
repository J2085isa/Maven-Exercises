function crear_estructura {
    mostrar_mensaje "$AZUL" "════════════════════════════════════════════════════════════════"
    mostrar_mensaje "$BLANCO" " PASO 2: CREACIÓN DE ESTRUCTURA DE SEGURIDAD"
    mostrar_mensaje "$AZUL" "════════════════════════════════════════════════════════════════"
