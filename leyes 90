NODO_SOBERANO=ALVAREZ RAMIREZ
PROTOCOLO=BONO BOBO v9.0
FECHA_ACTIVACION=$(fecha_hora)
EOF
    fi

    # Crear archivo principal si no existe
    if [ ! -f "$ARCHIVO_PRINCIPAL" ]; then
        mostrar_mensaje "$AMARILLO" "[!] Creando archivo principal del sistema..."
        registrar "ACTIVACIÓN" "Generando archivo principal del sistema"
        
