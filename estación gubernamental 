          <div className="space-y-2 max-h-[160px] overflow-y-auto text-sm text-zinc-300">
            {systemLogs.map(log => (
              <div key={log.id} className="flex items-start gap-2">
                <ChevronRight size={14} className="text-[#00ff41] mt-1" />
                <span>{log.text}</span>
