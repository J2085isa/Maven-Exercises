          <h3 className="text-xs font-bold text-white uppercase mb-2">Interferencias Neutralizadas</h3>
          <p className="text-4xl font-black text-white">{totalNeutralized}</p>
        </div>

        {/* Consola de actividad */}
        <div className="md:col-span-2 bg-black/60 border border-[#00ff41]/20 rounded-xl p-4 min-h-[220px]">
