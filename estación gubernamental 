const ImmunityProtocol = () => {
  const [totalNeutralized, setTotalNeutralized] = useState(0);
  const [systemLogs, setSystemLogs] = useState([]);
  const [isPulseActive, setIsPulseActive] = useState(false);
  const logsEndRef = useRef(null);

  const addLog = (text) => {
    setSystemLogs(prev => [...prev, { id: Date.now(), text }].slice(-10));
  };

  const triggerVibration = () => {
    if (navigator.vibrate) navigator.vibrate([200, 50, 200]);
    setIsPulseActive(true);
    setTimeout(() => setIsPulseActive(false), 1000);
  };

  useEffect(() => {
    addLog("✅ Protocolo de Inmunidad activado con llave única");
    addLog(`🔐 Frecuencia: ${LLAVE_UNICA}`);

    const interval = setInterval(() => {
      const escenarios = [
        "Detectando intento de regulación en Nodo Fiscal...",
        "Interfiriendo comunicación de comité bancario...",
        "Desplegando contramedida de reputación en redes políticas...",
        "Bloqueando acceso de agencia de inteligencia a portafolio...",
        "Redirigiendo rastreo a base de datos falsificada..."
      ];

      const log = escenarios[Math.floor(Math.random() * escenarios.length)];
      addLog(log);

      if (Math.random() > 0.82) {
        setTotalNeutralized(prev => prev + 1);
        triggerVibration();
        addLog("✅ OBJETIVO NEUTRALIZADO: Intento de acceso bloqueado");
      }

      logsEndRef.current?.scrollIntoView({ behavior: 'smooth' });
    }, 4000);

    return () => clearInterval(interval);
  }, []);

  return (
    <div className="bg-[#050505] border border-[#00ff41]/40 rounded-3xl p-6 mb-8">
      <h2 className="text-xl font-bold text-[#00ff41] mb-4 flex items-center gap-2">
