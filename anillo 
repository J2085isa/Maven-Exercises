    if estado_sistema:
        print(f"[REGISTRO] Estado del Nodo: {estado_sistema}\n")

    # Proceso de integración de núcleos
    print("[INICIO] Iniciando sincronización con red satelital...")
    for idx, pkg in enumerate(PAQUETES_NUCLEARES, start=1):
