def verificar_entorno() -> bool:
    """Verifica que el entorno sea compatible (Termux) antes de iniciar operaciones."""
    if not os.path.exists(RUTA_TERMINAL):
        print("[ALERTA] Entorno no reconocido. Se requiere Nodo Termux para integración satelital.")
        return False
    
    print(f"[VERIFICACIÓN] Entorno Nodo válido - Ruta confirmada: {RUTA_TERMINAL}")
    return True


def obtener_estado_sistema() -> Optional[str]:
    """Obtiene información básica del sistema para registro de operación."""
    try:
        resultado = subprocess.run(
            ["uname", "-a"],
            capture_output=True,
            text=True,
            check=True
        )
        return resultado.stdout.strip()
    except subprocess.CalledProcessError as e:
        print(f"[ADVERTENCIA] No se pudo obtener estado del sistema: {e.stderr.strip()}")
        return None


def activar_nucleos_dormidos() -> None:
