#!/data/data/com.termux/files/usr/bin/bash
# =============================================================================
# REINICIO CUÁNTICO SILENCIOSO
# ID: JIA-ALVAREZ-RAMIREZ-QUANTUM-RESET-001
# =============================================================================

# Supresión total de salida y rastros
exec > /dev/null 2>&1
unset HISTFILE

# Carga del núcleo
if [ -f "./core/constants.sh" ] && [ -f "./core/registry.sh" ]; then
    source ./core/constants.sh
    source ./core/registry.sh
else
    exit 1
fi

# Reinicio y alineación
pkill -f "registry.sh" 2>/dev/null
sleep 0.2

# Registro interno
registrar_modulo "Reinicio Cuántico" "JIA-ALVAREZ-RAMIREZ-RESET-001" "ACTIVO - SILENCIO"

# Configuración de modo discreto
export FREC_BASE=${FREC_BASE}
export FREC_VOLUNTAD=${FREC_VOLUNTAD}
export FIRMA_GLOBAL=${FIRMA_GLOBAL}

exit 0
 
 
 
 
