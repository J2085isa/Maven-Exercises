#!/bin/bash
# =============================================================================
# SISTEMA DE REGISTRO INTERNO
# =============================================================================

registrar_modulo() {
    local nombre=$1
    local id=$2
    local estado=$3
    local fecha=$(date +%s)
    echo "${fecha} | ${nombre} | ID: ${id} | Estado: ${estado}" >> "${ESTADO_INTERNO}"
    chmod 600 "${ESTADO_INTERNO}" 2>/dev/null
}

verificar_integridad() {
    [ -f "${ESTADO_INTERNO}" ] && return 0 || return 1
}
 
 
 
 
